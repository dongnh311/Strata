#!/usr/bin/env bash
# GENERATED by scripts/build-remote-command.sh — do not edit; edit remote-client.sh
# and lib/dsh-config.sh, then re-run the builder. This file is remote-client.sh with
# lib/dsh-config.sh inlined so it can be copied to another machine on its own.

#
# dsh-config.sh — the ONE writer of DeepSeek Harness's `cordis.patch.yml`.
#
# Sourced by scripts/dsh-direct.sh (runs on the box) and scripts/remote-client.sh (runs
# anywhere). It exists because those two scripts had begun to carry the same YAML twice, and a
# copied rule drifts: on 2026-08-17 a safety condition copied into two Swift views was fixed in
# one of them and left a button that loaded a second 20 GB model. Config is no different.
#
# ROUTES ARE CONDITIONAL ON EVIDENCE, never on hope. Each block below is written only when its
# credential or its endpoint is actually present, because a route that cannot work is worse than
# an absent one: it fails mid-turn with MISSING_CREDENTIAL after the user has typed a task.
#
# NO SECRET IS EVER WRITTEN INTO THE YAML. Every route names an ENV VAR; the caller exports the
# value it read from disk. That is what lets this file live in a public repo, and it is why the
# OCI key — which upstream `opencode` stores as a literal in its own config — is read at runtime
# and passed by name here.

# WHERE KEYS LIVE. `~/.local/ai-gateway/keys/<NAME>` is this box's key store — it already held
# GEMINI_API_KEY and OPENROUTER_API_KEY. An earlier version of this file probed two invented
# paths (`~/.openrouter.key`, `~/.google-ai.key`), found nothing, and reported "no key" about
# keys that were sitting in the store the whole time. A negative from a search that never looked
# in the obvious place is not a negative; the store is checked FIRST here for that reason.
# A PLACEHOLDER IS NOT A KEY, and passing one through is not a harmless no-op: the endpoint
# answers 401, which reads as "our credential was rejected" when the truth is "we sent the
# literal word YOUR_API_KEY". Measured 2026-08-18 — that substitution made the OCI route look
# permanently dead for a day while opencode, pointed at the SAME endpoint from a different file,
# worked fine. Filtering here means every caller of dsh_key inherits the guard.
dsh_is_placeholder() {
  case "$1" in
    ""|YOUR_*|your_*|CHANGEME*|changeme*|"<"*|xxx*|XXX*|sk-XXX*) return 0 ;;
    *) return 1 ;;
  esac
}

dsh_key() {
  local name="$1" v=""
  v="$(cat "$HOME/.local/ai-gateway/keys/$name" 2>/dev/null | tr -d '\r\n')"
  dsh_is_placeholder "$v" || { printf '%s' "$v"; return 0; }
  # Legacy/manual locations, kept so a key placed by hand still works. The store above is the
  # one place to put a new key; these exist so moving a key into it is never a breaking change.
  case "$name" in
    OPENROUTER_API_KEY) v="$(cat "$HOME/.openrouter.key" 2>/dev/null | tr -d '\r\n')" ;;
    GEMINI_API_KEY)     v="$(cat "$HOME/.google-ai.key" 2>/dev/null | tr -d '\r\n')" ;;
    OCI_API_KEY)        v="$(dsh_opencode_key)" ;;
  esac
  dsh_is_placeholder "$v" && v=""
  printf '%s' "$v"
}

# Resolve a provider's base URL from the ONE canonical source, config/providers.json
# (live copy ~/.local/ai-gateway/providers.json). $1 = dsh_provider_id, $2 = fallback.
#
# WHY A FALLBACK, AND WHY IT IS THE OLD LITERAL: a copied REMOTE client has no gateway
# package and no providers.json, so it must keep working byte-for-byte off the pinned
# literal — this is move-not-change, not a new dependency. On the box, where the file is
# seeded, the endpoint now comes from the single source that also feeds the gateway's
# routes.json, so onboarding a provider is one edit instead of two. No secret is read
# here — only the endpoint, which is not a credential (dsh_key still owns keys).
dsh_provider_base() {
  /usr/bin/python3 - "$1" "$2" <<'PY' 2>/dev/null
import json, os, sys
dsh_id, fallback = sys.argv[1], sys.argv[2]
path = os.environ.get("AI_GATEWAY_PROVIDERS") \
    or os.path.expanduser("~/.local/ai-gateway/providers.json")
try:
    doc = json.load(open(path))
    provs = doc.get("providers")
    if isinstance(provs, dict):
        for pid, spec in provs.items():
            if isinstance(spec, dict) \
                    and (spec.get("dsh_provider_id") or pid) == dsh_id \
                    and spec.get("base_url"):
                print(spec["base_url"]); break
        else:
            print(fallback)
    else:
        print(fallback)
except Exception:
    print(fallback)
PY
}

# Read the OCI Generative AI key out of opencode's config, which stores it as a literal.
#
# ⚠ THE DIRECTORY HOLDS FOUR CONFIGS AND ONLY ONE IS LIVE. On this box: opencode.json (the name
# opencode reads, real key), opencode.json.bak, opencode.jsonc, and opencode.jsonư — a typo. An
# earlier version of this function read ONLY opencode.jsonc, whose apiKey is the literal
# "YOUR_API_KEY", and the resulting 401 was written up as "OCI's key is dead". It was not: the
# same endpoint answered 200 to the key sitting in opencode.json the whole time. So the files
# are tried in order and a placeholder is skipped rather than returned — reading the wrong one
# of four near-identical files is the failure to design against, not a hypothetical.
dsh_opencode_key() {
  /usr/bin/python3 - "$HOME/.config/opencode/opencode.json" \
                     "$HOME/.config/opencode/opencode.jsonc" <<'PY' 2>/dev/null
import re, sys
for path in sys.argv[1:]:
    try:
        s = open(path, encoding="utf-8").read()
    except OSError:
        continue
    # Matched on the RAW text, deliberately. An earlier version stripped `//`-comments first —
    # and ate the `//` in `https://…`, leaving `baseURL: https:` and a YAML parse error. A
    # sanitiser that damages the field it is protecting is worse than no sanitiser; a quoted
    # JSON string value cannot contain an unescaped quote, so the pattern is enough on its own.
    m = re.search(r'"apiKey"\s*:\s*"([^"]+)"', s)
    if m and not m.group(1).upper().startswith(("YOUR_", "CHANGEME", "XXX")):
        print(m.group(1))
        break
PY
}

# Same four-file hazard as dsh_opencode_key: read the live config first, the .jsonc only as a
# fallback. The endpoint is identical in all four here, but "identical today" is not a property
# to depend on when the key in them already differs.
#
# ⚠ AND IT FALLS BACK TO A PINNED URL, because a key that travels without its endpoint is a key
# that cannot be used. Caught 2026-08-18 by running the built client on a machine that has the
# key store but no opencode: the key resolved, the base did not, so the route was dropped with
# `probe trả HTTP ?` — the probe had never run. Moving a credential into a shared store moves
# HALF a route; the address is the other half. This URL is a public Oracle regional endpoint,
# not a secret, and it is pinned for the same reason: the file holding the key carries no endpoint.
#
# Sourced from the canonical providers.json when present; the literal below is the
# move-not-change fallback for a remote client that has no such file. Same value either way.
DSH_OCI_BASE_DEFAULT="$(dsh_provider_base oci-osaka 'https://inference.generativeai.ap-osaka-1.oci.oraclecloud.com/20231130/actions/v1')"

dsh_oci_base() {
  local v
  v="$(/usr/bin/python3 - "$HOME/.config/opencode/opencode.json" \
                          "$HOME/.config/opencode/opencode.jsonc" <<'PY' 2>/dev/null
import re, sys
for path in sys.argv[1:]:
    try:
        s = open(path, encoding="utf-8").read()
    except OSError:
        continue
    m = re.search(r'"baseURL"\s*:\s*"([^"]+)"', s)   # raw text — see dsh_opencode_key
    if m:
        print(m.group(1))
        break
PY
)"
  printf '%s' "${v:-$DSH_OCI_BASE_DEFAULT}"
}

# Does the OCI route actually authenticate? Returns 0 only on a 2xx, and leaves the code in
# DSH_OCI_LAST_CODE so the caller can say WHAT happened instead of guessing.
#
# ⚠ `max_tokens` MUST BE ≥ 8. Measured 2026-08-18 against the live endpoint with the real key,
# same body, one field changed:
#
#     max_tokens=1 → 500      max_tokens=8  → 200
#     max_tokens=2 → 500      max_tokens=16 → 200
#
# gpt-oss emits reasoning before content, so a cap of 1-2 leaves no room for a reply and OCI
# returns `{"code":"500","message":"Internal Server Error."}` rather than a truncated answer.
# The previous version sent exactly `max_tokens: 1` "as the smallest request that can
# distinguish" auth from model errors, and that cap alone was enough to fail the gate on a
# perfectly working route.
#
# The comment it carried — "a __probe__ model cannot separate auth from model errors here, OCI
# answers 401 to both" — was FALSE, and false for an instructive reason: it was written while
# the caller was sending the placeholder string YOUR_API_KEY, so *every* response was 401 and
# the endpoint looked like it could not tell the two apart. Measured with a real key they are
# cleanly distinct, which is why the codes are now reported rather than collapsed:
#
#     bad key   → 401        unknown model → 404        working → 200
#
# So a probe's own design can be an artefact of the bug it was written under. Re-derive the
# behaviour after fixing the credential, never carry the conclusion across.
dsh_oci_reachable() {
  local base="$1" api_key="${2:-${OCI_API_KEY:-}}"
  DSH_OCI_LAST_CODE="$(curl -s -m 25 -o /dev/null -w '%{http_code}' -X POST "$base/chat/completions" \
    -H "Authorization: Bearer $api_key" -H 'Content-Type: application/json' \
    -d '{"model":"openai.gpt-oss-20b","messages":[{"role":"user","content":"hi"}],"max_tokens":8}' 2>/dev/null)"
  case "$DSH_OCI_LAST_CODE" in 2??) return 0 ;; *) return 1 ;; esac
}

# OpenRouter publishes its catalog WITHOUT a key, so the free list is fetched live instead of
# hard-coded. Model ids there churn — a list written into this file today names models that stop
# existing, and the failure surfaces as an unhelpful 404 mid-task. $1 = how many to offer.
dsh_openrouter_free_models() {
  local limit="${1:-8}"
  curl -s -m 12 https://openrouter.ai/api/v1/models 2>/dev/null \
    | /usr/bin/python3 -c '
import sys, json, re
try:
    data = json.load(sys.stdin).get("data") or []
except Exception:
    raise SystemExit
limit = int(sys.argv[1])
# Two ways a model is free to run here. Most carry the ":free" id suffix. But OpenRouter stealth
# preview models (e.g. stealth/ox-alpha, 1M ctx, added 2026-08-22) price prompt and completion at
# 0 WITHOUT that suffix, so a suffix-only test silently drops them. Also accept a zero-priced
# model, but only when its OUTPUT is text: google/lyria-3-* are zero-priced at 1M ctx too and
# would sort to the top of a coding picker while emitting audio, not code. Reading the LIVE
# catalog (not a static id list) keeps the no-hard-code rule above: a stealth id that stops
# existing simply stops appearing, with no 404.
def _price_zero(m):
    p = m.get("pricing") or {}
    def _z(x):
        try:
            return float(x) == 0.0
        except Exception:
            return False
    return _z(p.get("prompt")) and _z(p.get("completion"))
def _text_only_out(m):
    outs = (m.get("architecture") or {}).get("output_modalities") or []
    return "text" in outs and "audio" not in outs and "image" not in outs
free = [m for m in data
        if str(m.get("id", "")).endswith(":free")
        or (_price_zero(m) and _text_only_out(m))]
# Longest context first: on this box the harness is used for repo work, where the window is the
# binding constraint far more often than any quality difference between free models.
free.sort(key=lambda m: -(m.get("context_length") or 0))
for m in free[:limit]:
    ctx = m.get("context_length") or 131072
    # OpenRouter already ends most free-model names with "(free)"; appending another produced
    # "… (free) (free)" in the picker. Strip whatever it supplies, then add exactly one.
    name = (m.get("name") or m["id"]).replace(":", " ")
    name = re.sub(r"\s*\(free\)\s*$", "", name).strip()
    print("          - id: %s" % m["id"])
    print("            name: %s (free)" % name[:56])
    print("            contextWindow: %d" % ctx)
    print("            maxTokens: 8192")
' "$limit" 2>/dev/null
}

# Ask oMLX which models it can serve, and keep only the ones a human would pick. The registry
# lists drafters and vision sidecars beside the real checkpoints, and it lists the same
# checkpoint several times under namespaced ids (`scottlowry--…`, `stamsam--…`); offering all of
# them makes the picker a place to make a mistake. Emits: "<id>\t<label>" per line.
# $1 = base URL (no /v1), $2 = optional bearer token. The gateway needs one; oMLX does not.
# Generalised 2026-08-18 so the GATEWAY route can offer the same model choice as the direct one
# even from another machine — measured, /v1/models through the tunnel returns `local` plus the
# nine real ids, so nothing about this depends on being next to the box.
dsh_omlx_models() {
  local base="$1" auth="${2:-}"
  curl -s -m 12 ${auth:+-H "Authorization: Bearer $auth"} "$base/v1/models" 2>/dev/null \
    | /usr/bin/python3 -c '
import sys, json
try:
    ids = [m.get("id", "") for m in (json.load(sys.stdin).get("data") or [])]
except Exception:
    raise SystemExit
out = []
id_set = set(ids)
for i in ids:
    low = i.lower()
    if not i or "drafter" in low or "-vl-" in low or i == "local":
        continue          # drafter, vision sidecar, or the alias itself
    # `<org>--<name>` is a duplicate ONLY when the bare `<name>` is advertised too. Dropping every
    # namespaced id unconditionally deletes a checkpoint whose ONLY id is namespaced, and that is
    # not hypothetical: on 2026-08-18 the model_dir symlinks were removed because oMLX discovered
    # one snapshot twice and loaded the weights twice (33.19 GB, the two copies evicting each other
    # every few minutes). Afterwards the sole id for Qwen3.8-27B was
    # `scottlowry--Qwen3.8-27B-oQ4e-mtp`, this filter deleted it, and the picker offered no dense
    # model at all — the client then ran a 2B drafter on agentic prompts for four minutes without
    # anything reporting an error. Preferring the bare twin when BOTH exist keeps the old behaviour
    # byte for byte; the change is only about the case where there is no twin left to prefer.
    if "--" in i and i.split("--", 1)[1] in id_set:
        continue
    # The third field is the model'"'"'s OWN reasoning-effort vocabulary, read out of its
    # chat_template.jinja rather than assumed. They differ, and getting it wrong fails in two
    # different ways: an unsupported value makes Qwen3.8 raise, while Qwen3.6 silently ignores
    # every value because its template never mentions reasoning_effort.
    # The size token is REQUIRED, and that is not tidiness. Matching on the family alone labelled
    # `Qwen3.8-2B-oQ4e` — a 2B SpecPrefill drafter — as `Qwen3.8-27B dense`, and on 2026-08-18 that
    # is the label the user picked: four minutes of agentic prompts at 9.8k-11.9k tokens answered by
    # a 2B at 170-193 tok/s while the real model idles at ~11. Nothing errored, because a drafter
    # speaks the same protocol. An id that does not state the size gets NO claim about the model
    # and no effort vocabulary — showing the raw id is the honest failure, and it is the one the
    # user can see is wrong.
    if "qwen3.6" in low and "35b" in low:
        # These are real, different checkpoints. A generic family label made the picker show the
        # distilled oQ4-MTP and OptiQ 4-bit rows as duplicate models even though choosing either
        # changes the weights. Keep the exact bare-vs-namespaced alias de-duplication above, but
        # make distinct checkpoints visibly distinct here.
        if any(token in low for token in ("claude", "distill", "reasoning-distilled", "oq4-mtp")):
            label = "Qwen3.6-35B Distilled oQ4-MTP"
        elif "optiq" in low:
            label = "Qwen3.6-35B OptiQ 4-bit"
        else:
            label = "Qwen3.6-35B"
        # 0 occurrences of reasoning_effort in the template -> the level is not adjustable here.
        # Declaring levels anyway would put a control in the UI that is wired to nothing.
        out.append((i, label, ""))
    elif "qwen3.8" in low and "27b" in low:
        # Template: reasoning_effort not in ('xhigh','medium','low') -> raises. `max` is offered
        # as a rename of xhigh so the selector'"'"'s top level works instead of erroring.
        out.append((i, "Qwen3.8-27B dense (chậm ~3,5x decode)",
                    "low: low|medium: medium|xhigh: xhigh|max: xhigh"))
    elif "nemotron-3.5" in low and "30b" in low:
        # Exact route: NVIDIA-Nemotron-3.5-Lightning-30B-A3B-oQ4e-mtp.
        out.append((i, "Nemotron 3.5 Lightning 30B-A3B (nhanh · việc thường)",
                    "low: low|medium: medium|xhigh: xhigh|max: xhigh"))
    else:
        out.append((i, i, ""))
for i, label, efforts in out:
    print("%s\t%s\t%s" % (i, label, efforts))
'
}

# Start the optional direct-path guard. A copied remote client has no sibling Python file and
# therefore stays gateway-only; the on-box direct launcher treats a missing guard as a hard error.
# Globals set for the caller: DSH_PROXY_PID (empty when an existing matching proxy is reused) and
# DSH_PROXY_BASE. The health payload includes the upstream so another service on the port is not
# mistaken for our proxy.
dsh_start_single_model_proxy() {
  local upstream="$1" port="$2" state_dir="$3"
  local script="${DSH_PROXY_SCRIPT:-$SELF_DIR/omlx-single-model-proxy.py}"
  DSH_PROXY_PID=""
  DSH_PROXY_BASE="http://127.0.0.1:$port"
  [ -r "$script" ] || return 1
  local health
  health="$(curl -s -m 2 "$DSH_PROXY_BASE/health" 2>/dev/null || true)"
  if /usr/bin/python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
    expected = sys.argv[1].rstrip("/").removesuffix("/v1")
    raise SystemExit(0 if document.get("ok") is True and document.get("upstream") == expected else 1)
except Exception:
    raise SystemExit(1)' "$upstream" <<< "$health" 2>/dev/null
  then
    return 0
  fi
  mkdir -p "$state_dir"
  python3 "$script" --listen "$port" --upstream "$upstream" \
    >> "$state_dir/omlx-single-model-proxy.log" 2>&1 &
  DSH_PROXY_PID=$!
  local i
  for i in $(seq 1 50); do
    health="$(curl -s -m 2 "$DSH_PROXY_BASE/health" 2>/dev/null || true)"
    if /usr/bin/python3 -c 'import json, sys
try:
    document = json.load(sys.stdin)
    expected = sys.argv[1].rstrip("/").removesuffix("/v1")
    raise SystemExit(0 if document.get("ok") is True and document.get("upstream") == expected else 1)
except Exception:
    raise SystemExit(1)' "$upstream" <<< "$health" 2>/dev/null
    then
      return 0
    fi
    kill -0 "$DSH_PROXY_PID" 2>/dev/null || break
    sleep 0.1
  done
  kill "$DSH_PROXY_PID" 2>/dev/null || true
  wait "$DSH_PROXY_PID" 2>/dev/null || true
  DSH_PROXY_PID=""
  return 1
}

dsh_stop_single_model_proxy() {
  if [ -n "${DSH_PROXY_PID:-}" ]; then
    kill "$DSH_PROXY_PID" 2>/dev/null || true
    wait "$DSH_PROXY_PID" 2>/dev/null || true
    DSH_PROXY_PID=""
  fi
}

# Parse either the private runtime catalog or the public OpenAI model list into the same
# `<id>\t<label>\tefforts` shape. `/runtimes` is the authoritative source on the inference box, but
# the gateway intentionally blocks that admin/localhost endpoint for remote clients. The public
# `/v1/models` response is therefore the fallback, rather than treating an intentional 403 as an
# empty model catalog.
dsh_gateway_catalog_rows() {
  /usr/bin/python3 -c '
import sys, json
try:
    document = json.load(sys.stdin)
except Exception:
    raise SystemExit

choices = document.get("models")
candidates = []
if isinstance(choices, dict):
    # `/runtimes`: only expose enabled, active registry choices.
    for model_id, runtimes in choices.items():
        if not isinstance(model_id, str) or not isinstance(runtimes, list):
            continue
        active = next((item for item in runtimes
                       if isinstance(item, dict) and item.get("enabled") is True
                       and item.get("active") is True), None)
        if active is not None:
            candidates.append(model_id)
else:
    # Public `/v1/models`: this is already the gateway''s advertised request surface. Keep the
    # ids as advertised; the filters below remove the alias and sidecars.
    for item in document.get("data") or []:
        if isinstance(item, dict) and isinstance(item.get("id"), str):
            candidates.append(item["id"])

id_set = set(candidates)
for model_id in candidates:
    low = model_id.lower()
    if not model_id or model_id == "local" or "drafter" in low or "-vl-" in low:
        continue
    # Prefer the bare twin when both spellings advertise the same checkpoint. If only the
    # namespaced spelling exists, retain it: deleting the sole route makes the picker silently
    # fall back to the wrong model.
    if "--" in model_id and model_id.split("--", 1)[1] in id_set:
        continue
    # The 2026-09-28 lineup, by SHORT display name (rule 19). IQ2 alone gets effort levels: its GGUF
    # chat_template reads reasoning_effort and accepts exactly xhigh/medium/low (remote-client.sh
    # EFFORT_SUBSTRINGS has the evidence); max is offered as a rename of xhigh.
    if "ornith-1.5" in low:
        label, efforts = "Ornith-1.5-Abliterated", ""
    elif "qwopus3.6" in low and "coder" in low:
        label, efforts = "Qwopus3.6-35B-A3B-Coder", ""
    elif "flash-next" in low:
        label, efforts = "Qwen3.8-Flash-Next-IQ2", "low: low|medium: medium|xhigh: xhigh|max: xhigh"
    elif "qwen3.6" in low and "35b" in low:
        if any(token in low for token in ("claude", "distill", "reasoning-distilled", "oq4-mtp")):
            label = "Qwen3.6-35B Distilled oQ4-MTP"
        elif "optiq" in low:
            label = "Qwen3.6-35B OptiQ 4-bit"
        else:
            label = "Qwen3.6-35B"
        efforts = ""
    elif "qwen3.8" in low and "27b" in low:
        label = "Qwen3.8-27B dense (chậm ~3,5x decode)"
        efforts = "low: low|medium: medium|xhigh: xhigh|max: xhigh"
    elif "nemotron-3.5" in low and "30b" in low:
        # Exact route: NVIDIA-Nemotron-3.5-Lightning-30B-A3B-oQ4e-mtp.
        label = "Nemotron 3.5 Lightning 30B-A3B (nhanh · việc thường)"
        efforts = "low: low|medium: medium|xhigh: xhigh|max: xhigh"
    else:
        label, efforts = model_id, ""
    print("%s\t%s\t%s" % (model_id, label, efforts))
'
}

# Read only exact, enabled, active choices from the gateway registry. Fall back to the public
# `/v1/models` list when this is a remote client, where `/runtimes` is deliberately blocked.
# Emits the same `<id>\t<label>\tefforts` shape as dsh_omlx_models.
dsh_gateway_models() {
  local base="${1%/}" auth="${2:-}" payload="" rows=""
  # Set by the public fallback when the gateway identifies the model behind `local`. The caller
  # uses this only to choose an exact default; it is deliberately not emitted as a picker row.
  DSH_GATEWAY_SERVED_MODEL=""
  DSH_GATEWAY_ROWS=""
  if [ -n "$auth" ]; then
    payload="$(curl -s -m 12 -H "Authorization: Bearer $auth" \
      "$base/runtimes" 2>/dev/null || true)"
  else
    payload="$(curl -s -m 12 "$base/runtimes" 2>/dev/null || true)"
  fi
  rows="$(printf '%s' "$payload" | dsh_gateway_catalog_rows)"
  if [ -z "$rows" ]; then
    if [ -n "$auth" ]; then
      payload="$(curl -s -m 12 -H "Authorization: Bearer $auth" \
        "$base/v1/models" 2>/dev/null || true)"
    else
      payload="$(curl -s -m 12 "$base/v1/models" 2>/dev/null || true)"
    fi
    DSH_GATEWAY_SERVED_MODEL="$(printf '%s' "$payload" | /usr/bin/python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data") or []
except Exception:
    raise SystemExit
for item in data:
    if isinstance(item, dict) and item.get("id") == "local" and isinstance(item.get("served_model"), str):
        print(item["served_model"])
        break
' 2>/dev/null)"
    rows="$(printf '%s' "$payload" | dsh_gateway_catalog_rows)"
  fi
  # Keep the rows in a global as well as stdout. dsh_emit_config needs both the catalog and the
  # served-model metadata, but command substitution runs this function in a subshell and would
  # otherwise discard DSH_GATEWAY_SERVED_MODEL before the default-selection code can read it.
  DSH_GATEWAY_ROWS="$rows"
  [ -z "$rows" ] || printf '%s\n' "$rows"
}

# <id>\t<client compact threshold> for every gateway row that publishes a context contract (each
# local /v1/models row carries one since 2026-09-29: its OWN runtime guard, so a Coder row on oMLX and
# an Ornith row on ds4 differ). A row without one falls back to the shared window.
dsh_gateway_windows() {
  local base="${1%/}" auth="${2:-}" payload=""
  if [ -n "$auth" ]; then
    payload="$(curl -s -m 8 -H "Authorization: Bearer $auth" "$base/v1/models" 2>/dev/null || true)"
  else
    payload="$(curl -s -m 8 "$base/v1/models" 2>/dev/null || true)"
  fi
  printf '%s' "$payload" | /usr/bin/python3 -c '
import json, sys
try:
    data = json.load(sys.stdin).get("data") or []
except Exception:
    raise SystemExit
for item in data:
    if not isinstance(item, dict) or not isinstance(item.get("id"), str):
        continue
    value = (item.get("context_contract") or {}).get("client_compact_threshold")
    if isinstance(value, int) and value > 0:
        print("%s\t%d" % (item["id"], value))
' 2>/dev/null
}

# Emit the whole patch file on stdout. Args:
#   $1 gateway base URL (no /v1)   $2 gateway model id   $3 oMLX base URL ("" to omit the route)
#   $4 default provider route      $5 default model id
dsh_emit_config() {
  local gw_base="$1" gw_model="$2" omlx_base="$3" def_provider="$4" def_model="$5" picked_ctx="${6:-}"
  # The dense Qwen3.8 checkpoint can fit a larger nominal context, but the advertised
  # 126,976 + 32,768 generation envelope reproduced a 41.23 GB prefill on this 64 GB Mac and
  # crossed oMLX's dynamic ceiling. Keep one conservative envelope for direct and gateway rows so
  # the two DSH launchers cannot drift back into the OOM shape. Operators may still override the
  # runtime itself; this is the client-facing admission contract.
  #
  # DERIVE the window from the gateway's live /status contract, the SAME source remote-client.sh
  # (Claude Code) and codex-setup.sh (Codex) read — not a literal. Two reasons this matters, both
  # measured 2026-08-21: (1) `client_compact_threshold` is `guard − headroom` (40,960 = 57,344 −
  # 16,384), so a hardcoded 57,344 was the ONLY client compacting AT the ceiling with no room for
  # the next turn — 57 % of DSH's requests crossed 57,344 and the gateway re-compacted them
  # server-side, destroying the prefix cache each time. (2) A literal drifts when the runtime's
  # per-model ceiling changes; the contract does not. /status is open on loopback (no key needed
  # here). Fall back to the old conservative literal only when the contract cannot be read.
  local local_context local_max_tokens=16384
  # Prefer the PICKED model's window (remote-client apply_model_context_window -> /v1/models
  # context_length - 16384 headroom), so an on-demand slot like DS4-IQ2 (163,840) is honored instead
  # of the RESIDENT model's /status threshold (which is what the scrape below returns — wrong model
  # when the pick differs from what is loaded). Fall back to the /status contract, then the literal.
  if [ -n "$picked_ctx" ] && [ "$picked_ctx" -gt 0 ] 2>/dev/null; then
    local_context="$picked_ctx"
  else
    local_context="$(curl -s -m 4 "$gw_base/status" 2>/dev/null \
      | sed -n 's/.*"client_compact_threshold"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
    case "$local_context" in ''|*[!0-9]*) local_context=57344 ;; esac
  fi
  local summary_provider="ai-gateway" summary_model="local-nothink"

  cat <<YML
# Generated by scripts/lib/dsh-config.sh — do not edit by hand, it is rewritten every launch.
#
# The DeepSeek catalog is silenced rather than left alone. With no \`models\` key the
# llm-deepseek adapter advertises \`deepseek-v4-flash\` and \`deepseek-v4-pro\` (its README:
# "Omitting models advertises …"), and this box has no DeepSeek credential — so the picker
# offered two entries whose only possible outcome was
# "no API key for provider route deepseek-official". \`models: []\` advertises none.
- id: llm-deepseek
  config:
    models: []

- id: llm-pi-ai
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
YML

  # ── oMLX, direct, one entry per real checkpoint ────────────────────────────────────────────
  # ⚠ Selecting one of these SWITCHES THE MODEL FOR THE WHOLE BOX, not for this chat: oMLX
  # serves the gateway too, and it holds one model at a time, so the next request naming a
  # different id evicts what Claude Code / codex / webchat are using. That is also what makes
  # "always exactly one model loaded" true here — it is oMLX's own behaviour, not something this
  # config enforces, and the labels say so where the user chooses.
  local omlx_rows="" gw_rows="" gateway_default_model="" agent_default_model="$def_model"
  if [ -n "$omlx_base" ]; then
    omlx_rows="$(dsh_omlx_models "$omlx_base")"
    if [ -n "$omlx_rows" ]; then
      cat <<YML
      omlx-direct:
        displayName: oMLX direct
        apiKeyEnv: OMLX_API_KEY
        api: openai-completions
        baseURL: $omlx_base/v1
        # A private endpoint's URL tells pi-ai nothing, so the dialect is stated. oMLX accepts
        # top-level reasoning_effort and forwards it to the chat template
        # (omlx/api/openai_models.py:319-320); it does NOT read DeepSeek's thinking.type.
        compat:
          thinkingFormat: openai
        models:
YML
      printf '%s\n' "$omlx_rows" | while IFS="$(printf '\t')" read -r mid label efforts; do
        [ -z "$mid" ] && continue
        case "$label" in
          Qwen3.*|Nemotron\ 3.5*)
            cat <<YML
          - id: ${mid}-nothink
            name: $label · thinking OFF · ĐỔI CẢ HỘP
            contextWindow: $local_context
            maxTokens: $local_max_tokens
            reasoningEfforts: false
          - id: ${mid}-think
            name: $label · thinking ON · ĐỔI CẢ HỘP
            contextWindow: $local_context
            maxTokens: $local_max_tokens
YML
            if [ -n "$efforts" ]; then
              echo "            reasoningEfforts:"
              printf '%s\n' "$efforts" | tr '|' '\n' | while read -r lvl; do
                [ -n "$lvl" ] && echo "              $lvl"
              done
            else
              echo "            reasoningEfforts: false"
            fi
            ;;
          *)
            cat <<YML
          - id: $mid
            name: $label · thinking mặc định · ĐỔI CẢ HỘP
            # Keep input plus generation below the measured dense-model memory envelope.
            contextWindow: $local_context
            maxTokens: $local_max_tokens
            reasoningEfforts: false
YML
            ;;
        esac
      done
    fi
  fi

  # ── The gateway: everything the direct route lacks, at the cost of ~1.2-1.6x decode ─────────
  # Read exact active choices from /runtimes instead of copying the backend's raw /v1/models list.
  # The raw list includes cached sidecars and IDs that are not exact gateway registry routes.
  #
  # `local` and its think variants remain stable internal aliases for Claude/Codex/OpenCode, but
  # they are deliberately NOT DSH picker rows: showing the currently served model was a misleading
  # duplicate of the exact rows. The default agent model is selected from the hidden alias below.
  cat <<YML
      ai-gateway:
        displayName: AI Gateway
        apiKeyEnv: AI_GATEWAY_KEY
        api: openai-completions
        baseURL: $gw_base/v1
        models:
YML
  # Both aliases are explicit: the bare model id would inherit the template default and is not a
  # truthful "thinking OFF" choice.
  dsh_gateway_models "$gw_base" "${AI_GATEWAY_KEY:-}" >/dev/null
  gw_rows="$DSH_GATEWAY_ROWS"
  gw_windows="$(dsh_gateway_windows "$gw_base" "${AI_GATEWAY_KEY:-}")"
  if [ -n "$gw_rows" ]; then
    gateway_default_model="$(printf '%s\n' "$gw_rows" | awk -F '\t' -v want="$gw_model" '$1 == want { print $1; exit }')"
    if [ -z "$gateway_default_model" ]; then
      gateway_default_model="$(printf '%s\n' "$gw_rows" | awk -F '\t' -v want="${DSH_GATEWAY_SERVED_MODEL:-}" '$1 == want { print $1; exit }')"
    fi
    printf '%s\n' "$gw_rows" | while IFS="$(printf '\t')" read -r mid label efforts; do
      [ -z "$mid" ] && continue
      # This row's own runtime window, never above the one the launcher resolved (an explicit lower
      # REMOTE_CTX still wins); a row with no published contract keeps the shared window.
      row_ctx="$(printf '%s\n' "$gw_windows" | awk -F '\t' -v m="$mid" '$1 == m { print $2; exit }')"
      case "$row_ctx" in ''|*[!0-9]*) row_ctx="$local_context" ;; esac
      [ "$row_ctx" -gt "$local_context" ] 2>/dev/null && row_ctx="$local_context"
          cat <<YML
          - id: ${mid}-nothink
            name: Gateway · $label · thinking OFF · ĐỔI CẢ HỘP
            contextWindow: $row_ctx
            maxTokens: $local_max_tokens
            reasoningEfforts: false
          - id: ${mid}-think
            name: Gateway · $label · thinking ON · ĐỔI CẢ HỘP
            contextWindow: $row_ctx
            maxTokens: $local_max_tokens
YML
      if [ -n "$efforts" ]; then
        echo "            reasoningEfforts:"
        printf '%s\n' "$efforts" | tr '|' '\n' | while read -r lvl; do
          [ -n "$lvl" ] && echo "              $lvl"
        done
      else
        echo "            reasoningEfforts: false"
      fi
    done
    summary_provider="ai-gateway"
    summary_model="${gateway_default_model:+${gateway_default_model}-nothink}"
    [ -n "$summary_model" ] || summary_model="local-nothink"
    if [ -n "$gateway_default_model" ]; then
      agent_default_model="${gateway_default_model}-think"
    else
      agent_default_model="${def_model}-think"
    fi
  elif [ -n "$omlx_rows" ] && [ "$def_provider" = "omlx-direct" ]; then
    # Direct mode still has a no-thinking compaction fallback when the gateway catalog/key is
    # unavailable. The loopback proxy strips this suffix and injects enable_thinking=false.
    summary_provider="omlx-direct"
    summary_model="${def_model}-nothink"
    agent_default_model="${def_model}-think"
  fi

  # ── OCI Generative AI (Osaka): gpt-oss, taken from opencode's own config on this box ────────
  # GATED ON A LIVE 200, not on the key existing — a route that cannot work is worse than an
  # absent one, because it fails after the user has typed a task. One small request per launch
  # is the price of the picker telling the truth.
  #
  # ⚠ RETRACTION, 2026-08-18. This block used to record: "measured 2026-08-17, the key answers
  # 401, and so does a request with NO key — the two are indistinguishable". Both halves were
  # wrong, and the gate correctly dropped a route that worked. Two independent defects, either
  # one sufficient on its own:
  #
  #   1. the key was read from opencode.jsonc, which holds the literal YOUR_API_KEY, while
  #      opencode itself reads opencode.json, which holds the real one → 401 for both arms of
  #      the "comparison", which is what made them look indistinguishable;
  #   2. the probe capped max_tokens at 1, which this endpoint answers with 500 even when the
  #      credential is good.
  #
  # Defect 2 was DESIGNED BY defect 1: the one-token cap existed to work around an
  # indistinguishability that only existed because the credential was junk. The user reported
  # it as "it runs fine in opencode" — the same endpoint, reached through a different file.
  # Two instruments disagreeing about one endpoint is a fact about the instruments.
  local oci_base; oci_base="$(dsh_oci_base)"
  if [ -n "${OCI_API_KEY:-}" ] && [ -n "$oci_base" ] \
     && ! dsh_oci_reachable "$oci_base" "${OCI_API_KEY:-}"; then
    # HTTP 000 means the client could not establish a connection. It is not evidence that the
    # credential or model is invalid, and hiding a known 120B route on that basis is what made the
    # model disappear from remote-client. Keep the route for an inconclusive network probe; a
    # definitive HTTP response (401/403/404/5xx) still suppresses a route that cannot work.
    case "${DSH_OCI_LAST_CODE:-}" in
      000|"") ;;
      *) oci_base="" ;;
    esac
  fi
  if [ -n "${OCI_API_KEY:-}" ] && [ -n "$oci_base" ]; then
    cat <<YML
      oci-osaka:
        displayName: OCI Osaka (gpt-oss)
        apiKeyEnv: OCI_API_KEY
        api: openai-completions
        baseURL: $oci_base
        models:
          - id: openai.gpt-oss-120b
            name: gpt-oss-120B · OCI Osaka
            # Both numbers come from opencode.json's own declaration for this endpoint, which
            # is the only statement about it anyone here has; nothing was measured. What WAS
            # measured (2026-08-18) is that this id answers 200 — see dsh_oci_reachable.
            contextWindow: 128000
            maxTokens: 16384
          - id: openai.gpt-oss-20b
            name: gpt-oss-20B · OCI Osaka
            contextWindow: 128000
            maxTokens: 16384
YML
  fi

  # ── mwapi.dev (Claude) REMOVED 2026-08-23: account out of credit (user). If a Claude-serving
  # provider is added later, do NOT give it a bare `claude-` gateway prefix — that hijacks Claude
  # Code's own subagent ids to cloud (compat/__init__.py:344). Use a namespaced route + model-id
  # rewrite (the P4 mechanism, reverted with mwapi; design in
  # reports/plan-model-api-provider-2026-08-23/PLAN.md). DSH picker access is a hand-pick and safe.

  # ── OpenRouter, free tier only ──────────────────────────────────────────────────────────────
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    local or_models; or_models="$(dsh_openrouter_free_models 8)"
    if [ -n "$or_models" ]; then
      cat <<YML
      openrouter:
        displayName: OpenRouter (free)
        apiKeyEnv: OPENROUTER_API_KEY
        models:
$or_models
YML
    fi
  fi

  # ── Google AI Studio ────────────────────────────────────────────────────────────────────────
  # ONLY `-latest` ALIASES, and both halves of that were measured 2026-08-17.
  #
  #  * `/v1beta/models` is NOT a statement about what this key can CALL. It listed
  #    `gemini-2.5-flash`, which answers 404 "no longer available to new users. Please update
  #    your code to use models/gemini-3.6-flash". A catalog that lists models the caller cannot
  #    use is the same shape as `/v1/models` on mlx_lm advertising every cached checkpoint.
  #  * PROBING each candidate at launch — the obvious fix — is self-defeating: six rapid calls
  #    put the key into a throttled state that answers **404 with an empty body**, not 429, so
  #    the probe would report every model dead. After a 20s pause the same call returned 200.
  #    A detector that trips the condition it measures cannot be used here.
  #
  # The aliases sidestep both: Google repoints them at the current model, so no id goes stale
  # and nothing has to be probed. Free-tier membership is still NOT asserted — no endpoint here
  # reports it, so the label names the model family and the quota line says it cannot be read.
  if [ -n "${GEMINI_API_KEY:-}" ]; then
    cat <<YML
      google:
        displayName: Google AI Studio
        apiKeyEnv: GEMINI_API_KEY
        models:
          - id: gemini-flash-latest
            name: Gemini Flash (latest) · đã đo gọi được
            contextWindow: 1048576
            maxTokens: 65536
            # These ids are NOT in pi-ai's shipped catalog, so they are hand-declared and inherit
            # nothing — without this block they would be non-reasoning models with no selector,
            # which is why the Effort control vanished for them. Google's own protocol carries
            # the level (\`thinkingConfig.thinkingBudget\` / \`thinkingLevel\`,
            # api/google-generative-ai.js:286-297), and pi-ai has a real disabled config for Off
            # (\`thinkingBudget: 0\`, :336) — so unlike the oMLX route, Off here actually turns it
            # off rather than sending nothing.
            reasoningEfforts:
              off:
              low: low
              medium: medium
              high: high
          - id: gemini-flash-lite-latest
            name: Gemini Flash-Lite (latest) · rẻ nhất
            contextWindow: 1048576
            maxTokens: 65536
            reasoningEfforts:
              off:
              low: low
              medium: medium
              high: high
          - id: gemini-pro-latest
            name: Gemini Pro (latest) · mạnh nhất, tốn quota nhất
            contextWindow: 1048576
            maxTokens: 65536
            reasoningEfforts:
              off:
              low: low
              medium: medium
              high: high
YML
  fi

  # ── DSH compaction policy ───────────────────────────────────────────────────────────────────
  # The summary call must be materially smaller than the history it replaces. A 16384 cap lets a
  # thinking dense model spend the whole budget on hidden reasoning and return no useful checkpoint;
  # the next request then carries the original surface unchanged. Keep the summary call at 4096,
  # compact at 70% and retain only 12% of the local window so the next dense prefill has headroom.
  # Keep the whole preset group here because a home patch replaces the row's complete config rather
  # than deep-merging it.
  cat <<YML

- id: compaction
  name: cordis:group
  group: true
  isolate:
    compaction: true
    toolResultPruner: true
  config:
    - id: compaction-basic
      name: '@deepseek-ai/dsh-compaction-basic'
      config:
        summarizationProvider: $summary_provider
        summarizationModel: $summary_model
        thresholdRatio: 0.70
        retainRatio: 0.12
        maxTokens: 4096
        compactionRetries: 1
        maxOverflowRetries: 2
    - id: command-compact
      name: '@deepseek-ai/dsh-command-compact'
    - id: tool-result-pruner
      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
      config:
        thresholdChars: 8192
        headChars: 4096
        tailChars: 1024
YML

  cat <<YML

- id: agent-default-model
  config:
    provider: $def_provider
    model: $agent_default_model
YML
}

# Print the routes that were ACTUALLY written, read back from the file. $1 = path to the YAML.
#
# Both callers had a summary computed from the same inputs the generator used, and both drifted
# from it the moment a route gained a condition the summary did not know about: the OCI route is
# gated on a live 200, so a present-but-rejected key made dsh-direct.sh announce an entry the
# config did not contain. That was fixed there and NOT here — the same copied-rule failure this
# whole file exists to stop — so the printer moved in beside the writer. A summary computed
# beside its subject reports on itself; one read back from the artefact cannot.
dsh_print_routes() {
  /usr/bin/python3 - "$1" <<'PYR'
import re, sys
try:
    lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
except OSError:
    raise SystemExit
NOTE = {"omlx-direct": "thinking ON  · ⚠ ĐỔI MODEL Ở ĐÂY LÀ ĐỔI CẢ HỘP",
        "ai-gateway": "thinking ON/OFF · guard + telemetry",
        "openrouter": "chỉ model :free",
        "google": "Gemini · có mức Effort",
        "oci-osaka": "gpt-oss"}
route, n, models, cur = None, 0, {}, None
for ln in lines:
    m = re.match(r"^      ([a-z0-9-]+):\s*$", ln)
    if m:
        route = m.group(1); n += 1; cur = route; models[cur] = []
        print("  %d) %-12s %s" % (n, route, NOTE.get(route, "")))
        continue
    m = re.match(r"^          - id: (\S+)", ln)
    if m and cur:
        models[cur].append([m.group(1), False])
    if re.match(r"^            reasoningEfforts:\s*$", ln) and cur and models[cur]:
        models[cur][-1][1] = True
eff = [mid for r in models for mid, has in models[r] if has]
if eff:
    print("     có mức Effort: " + ", ".join(m[:34] for m in eff))
PYR
}

# Print what a route costs the user to know, and what could not be established. Quota is the
# honest part: only OpenRouter exposes a remaining-credit endpoint, and it needs the key.
dsh_print_quota() {
  if [ -n "${OPENROUTER_API_KEY:-}" ]; then
    curl -s -m 8 -H "Authorization: Bearer $OPENROUTER_API_KEY" \
      https://openrouter.ai/api/v1/auth/key 2>/dev/null \
      | /usr/bin/python3 -c '
import sys, json
try:
    d = (json.load(sys.stdin) or {}).get("data") or {}
except Exception:
    raise SystemExit
limit, used = d.get("limit"), d.get("usage")
free = d.get("is_free_tier")
if limit is None:
    # A null limit means no credit CAP, not unlimited use — spend still accrues, and on a
    # non-free-tier key a paid model bills for real. Say both, or this line reads as "free".
    print("  OpenRouter : đã dùng %.4f tín dụng · KHÔNG có trần (tài khoản %s)"
          % (used or 0, "free-tier" if free else "TRẢ PHÍ — chỉ model :free là miễn phí"))
else:
    print("  OpenRouter : còn %.4f / %.4f tín dụng" % (limit - (used or 0), limit))
' 2>/dev/null
  fi
  # An absent key is the common case on a CLIENT machine, and silence there reads as "this
  # feature does not exist" rather than "you have not given it a key". Name the exact path.
  [ -z "${OPENROUTER_API_KEY:-}" ] \
    && echo "  OpenRouter : chưa có key → ~/.local/ai-gateway/keys/OPENROUTER_API_KEY (chmod 600)"
  [ -z "${GEMINI_API_KEY:-}" ] \
    && echo "  Gemini     : chưa có key → ~/.local/ai-gateway/keys/GEMINI_API_KEY (chmod 600)"
  # Google publishes no remaining-quota endpoint; saying "unknown" beats inventing a number.
  [ -n "${GEMINI_API_KEY:-}" ] && echo "  Gemini     : hạn mức còn lại KHÔNG có endpoint để hỏi — xem aistudio.google.com"
  return 0
}

dsh_install_embedded_proxy() {
  /usr/bin/python3 - "$1" <<'PY_PROXY_INSTALL'
import base64, pathlib, sys
pathlib.Path(sys.argv[1]).write_bytes(base64.b64decode(''))
pathlib.Path(sys.argv[1]).chmod(0o700)
PY_PROXY_INSTALL
}

wf_emit_batch_tools() {
  local d="${1:-${WF_RULES_DIR:-$HOME/.remote-workflow}}"; mkdir -p "$d" 2>/dev/null || true
  /usr/bin/python3 - "$d" <<'PY_WF_TOOLS'
import base64, os, sys
d = sys.argv[1]
blobs = {}
blobs['wf_ui.py'] = ''
blobs['run_tasks.py'] = ''
blobs['tasks_gen.py'] = ''
for _n, _b in blobs.items():
    open(os.path.join(d, _n), "wb").write(base64.b64decode(_b))
PY_WF_TOOLS
}

#
# remote-client.sh — RUN THIS ON THE CLIENT MACHINE (máy khác, macOS hoặc Linux).
#
# Mở Claude Code, Codex, OpenCode, DeepSeek Harness, hoặc Chat REPL — tất cả trỏ về AI stack trên Mac chủ
# (go-llm-proxy) qua internet (https://api.dongnh.dev, Cloudflare Tunnel) hoặc
# LAN/Tailscale. Máy client KHÔNG chạy inference — Mac chủ làm hết.
#
# LƯU Ý: scripts/remote-client.command (bản macOS double-click) là BẢN SAO Y
# của file này — sửa file này xong hãy `cp` đè sang .command để hai bản khớp.
#
# Cài trên client: copy đúng MỘT file này (scp / AirDrop / git). Cần bash +
# curl, và CLI muốn dùng:
#   claude → Claude Code : npm install -g @anthropic-ai/claude-code
#   codex  → Codex CLI   : npm install -g @openai/codex
#   opencode → OpenCode CLI (đã cài sẵn OpenCode)
#   dsh    → DeepSeek Harness : chỉ cần Node 20+ (npx tự tải, không cần cài trước)
#   chat   → chỉ cần python3 (sẵn trên hầu hết macOS/Linux)
#
# Usage:
#   ./remote-client.sh                  # menu
#   ./remote-client.sh claude [args…]   # hoặc: codex / opencode / dsh / chat / workflow / status
#   ./remote-client.sh dsh              # Web UI :3080, làm việc trong thư mục hiện hành
#   ./remote-client.sh dsh -C ~/code/x  # …trong thư mục đó; thêm --profile headless "việc"
#   ./remote-client.sh workflow "tính năng"      # tự sinh plan nhiều task rồi chạy từng task (test đóng băng)
#   ./remote-client.sh workflow ~/repo/plan.md   # file plan có ### Task → chạy từng task, resume được
#   -C / --dir dùng được cho MỌI lệnh agent (claude · codex · opencode · dsh · workflow), và
#   thư mục làm việc LUÔN được in ra dù có dùng -C hay không.
#   ./remote-client.sh status           # AI sống không? decode được không?
#
# Đổi địa chỉ không cần sửa file:
#   REMOTE_BASES="https://api.dongnh.dev 192.168.1.92" ./remote-client.sh claude
#
set -uo pipefail

# ── Where the AI is reachable. The route is picked by WHERE THIS CLIENT RUNS: ──
#    • ON THE INFERENCE MAC (the box that fronts the tunnel) → loopback 127.0.0.1 first:
#      zero internet, zero Cloudflare edge, and — decisive — no 120s Proxy Read Timeout that
#      kills slow local turns (524s measured on 2026-09-14). A plain loopback peer needs no key
#      at all (gateway/auth.py trusts it unless X-Forwarded-For is present = arrived via
#      cloudflared), but the SAME sk-live key still works on loopback, so the probe uses it and
#      nothing new to store.
#    • ON A CLIENT MACHINE (elsewhere) → loopback is not the gateway and is probed out-of-band;
#      the queue falls through to the public domain (always reachable, no Tailscale/LAN needed).
#    An explicit REMOTE_BASES (or REMOTE_HOSTS) is the full override: the auto-detect below is
#    skipped entirely, so `REMOTE_BASES="https://api.dongnh.dev 192.168.1.92"` still does exactly
#    what the old default did.
DEFAULT_BASES="https://api.dongnh.dev"
LOCAL_LOOPBACK="127.0.0.1"
KEY="${REMOTE_KEY:-$(cat "$HOME/.airkey" 2>/dev/null)}"
# Build the candidate queue. When the user pins REMOTE_BASES / REMOTE_HOSTS we honour it
# verbatim (full override, backward-compatible with the old default). Otherwise we try the
# two routes that always exist, in this order: loopback first (fast on the inference Mac),
# then the public domain. A loopback candidate that does not reach a gateway is skipped by
# the probe below (4s budget, 000 → fall through) without blocking the public route, so this
# costs a remote client almost nothing and gives the inference-Mac client a direct line.
# For a Tailscale/LAN hop to the inference Mac, use REMOTE_BASES="192.168.1.92" — a LAN
# address is a bare-host entry and is probed exactly like the others.
if [ -z "${REMOTE_BASES:-}" ] && [ -z "${REMOTE_HOSTS:-}" ]; then
  BASES="$LOCAL_LOOPBACK $DEFAULT_BASES"
else
  BASES="${REMOTE_BASES:-${REMOTE_HOSTS:-}}"
fi
MODEL="${REMOTE_MODEL:-local}"   # stable alias published by go-llm-proxy
MODEL_PINNED=0
[ -n "${REMOTE_MODEL:-}" ] && MODEL_PINNED=1
# set -u: REMOTE_SAFE chỉ được ĐỌC (không bao giờ gán) → phải có default, nếu
# không mọi lần chạy `claude`/`codex` mà user chưa export sẽ chết "unbound var".
REMOTE_SAFE="${REMOTE_SAFE:-}"
# Optional Claude Code local-evaluation mode. Keep this opt-in: --bare skips automatic
# customizations (including CLAUDE.md discovery), so the task prompt must explicitly tell Claude
# which repository rules/files to read when this is enabled.
REMOTE_CLAUDE_MINIMAL="${REMOTE_CLAUDE_MINIMAL:-0}"
# Client self-compact ceiling. When REMOTE_CTX is absent, it is resolved from the
# gateway's versioned /status context_contract after a host is selected. The
# literal fallback is only for an older gateway that does not publish the
# contract; it is never used silently.
CTX_WINDOW="${REMOTE_CTX:-}"
CONTEXT_FALLBACK=57344

# a list entry → base URL: full URL kept as-is, bare host → http://host:8090 (the ai-gateway;
# go-llm-proxy :9090 was retired 2026-07-18 — the gateway does auth + translation directly).
to_base() { case "$1" in http://*|https://*) printf '%s' "$1" ;; *) printf 'http://%s:%s' "$1" "${REMOTE_PORT:-8090}" ;; esac; }

# Where this file lives, so the shared config generator can be found when it is co-located.
# Resolved once and tolerantly: a copy of this script ALONE on another machine still works, it
# just falls back to the gateway-only route (see run_dsh).
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd -P || echo .)"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
ok()   { printf '\033[32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[33m! %s\033[0m\n' "$*"; }
err()  { printf '\033[31m✗ %s\033[0m\n' "$*" >&2; }

validate_ctx() {
  case "$1" in
    ''|*[!0-9]*|0)
      err "REMOTE_CTX phải là số nguyên dương."
      exit 2
      ;;
  esac
}

[ -z "$CTX_WINDOW" ] || validate_ctx "$CTX_WINDOW"

case "$REMOTE_CLAUDE_MINIMAL" in
  0|1) ;;
  *)
    err "REMOTE_CLAUDE_MINIMAL phải là 0 hoặc 1."
    exit 2
    ;;
esac

if [ -z "$KEY" ]; then
  err "Chưa có API key. Làm 1 trong 2 cách rồi chạy lại:"
  echo "   1) Lưu key 1 lần (khuyên dùng):"
  echo "        printf 'sk-live-XXXXXXXX' > ~/.airkey && chmod 600 ~/.airkey"
  echo "        $0"
  echo "   2) Hoặc đặt tạm mỗi lần:"
  echo "        REMOTE_KEY=sk-live-XXXXXXXX $0"
  echo "   (Lấy key trên MÁY CHỦ:  cat ~/.local/go-llm-proxy/api-key )"
  read -r -p "Nhấn Return để đóng…" _ 2>/dev/null || true
  exit 1
fi

# ── Pick the first reachable host, reporting WHY each one fails so a stuck
#    client can be diagnosed on the spot. ──
echo
dim "Đang tìm AI local (thử: $BASES) …"
BASE=""
for h in $BASES; do
  b="$(to_base "$h")"
  # 8s: a cold path can take a few seconds on the first hit.
  code="$(curl -s -m 8 -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $KEY" "$b/v1/models" 2>/dev/null)"
  case "$code" in
    200)          ok   "$b → 200"; BASE="$b"; break ;;
    000|"")       if [ "$b" = "http://$LOCAL_LOOPBACK:8090" ]; then
                    dim  "$b → không có gateway loopback (đang chạy trên máy KHÁC) → bỏ qua."
                  else
                    warn "$b → không tới được (timeout / mạng / firewall)"
                  fi ;;
    401|403|429)  warn "$b → $code (key sai, hoặc proxy đang throttle IP này)" ;;
    404)          warn "$b → 404 (không phải go-llm-proxy)" ;;
    *)            warn "$b → HTTP $code" ;;
  esac
done

if [ -z "$BASE" ]; then
  err "Không kết nối được AI local. Xử lý theo mã lỗi ở trên:"
  echo "  • không tới được : kiểm tra internet; Mac chủ đang bật + cloudflared tunnel chạy."
  echo "                     LAN/Tailscale → REMOTE_BASES=\"192.168.1.92\" $0 … (mạng nội bộ, không qua Cloudflare)"
  echo "  • 401/403/429    : sai REMOTE_KEY (key mạnh), hoặc bị throttle — chờ ~1 phút."
  echo "  • 404            : URL không phải go-llm-proxy (xem lại REMOTE_BASES)."
  read -r -p "Nhấn Return để đóng…" _ 2>/dev/null || true
  exit 1
fi

# The gateway owns the context contract. An explicit REMOTE_CTX may only lower
# the advertised client threshold; a larger value would consume the headroom
# that protects system/tool/output tokens from the backend guard.
CONTEXT_JSON="$(curl -s -m 4 -H "Authorization: Bearer $KEY" "$BASE/status" 2>/dev/null || true)"
CONTRACT_COMPACT="$(printf '%s' "$CONTEXT_JSON" | sed -n 's/.*"client_compact_threshold"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
CONTRACT_GUARD="$(printf '%s' "$CONTEXT_JSON" | sed -n 's/.*"guard_tokens"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1)"
# /status is loopback-only: from another machine it answers 403, the contract was never read, and the
# launcher compacted at the 57344 fallback while the box guarded at 180224 (2026-09-29). The
# key-protected /v1/models `local` entry carries the same contract (gateway status_api.contract_for),
# plus served_model and backend_reachable. `local` is data[0]; the JSON is split on "id" so a LATER
# row's contract can never be read as local's (a greedy sed over the whole list would take the last).
MODELS_JSON="$(curl -s -m 6 -H "Authorization: Bearer $KEY" "$BASE/v1/models" 2>/dev/null || true)"
LOCAL_ENTRY="$(printf '%s' "$MODELS_JSON" | awk -F'"id"' 'NR==1 {print $2}')"
case "$LOCAL_ENTRY" in *'"local"'*) ;; *) LOCAL_ENTRY="" ;; esac
json_int() {  # $1=key $2=json text → first integer value of that key
  printf '%s' "$2" | grep -o "\"$1\"[[:space:]]*:[[:space:]]*[0-9][0-9]*" | head -1 | grep -o '[0-9][0-9]*$'
}
json_str_field() {  # $1=key $2=json text → first string value of that key
  printf '%s' "$2" | grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 \
    | sed 's/.*:[[:space:]]*"\(.*\)"$/\1/'
}
if [ -z "$CONTRACT_COMPACT" ] || [ -z "$CONTRACT_GUARD" ]; then
  CONTRACT_COMPACT="$(json_int client_compact_threshold "$LOCAL_ENTRY")"
  CONTRACT_GUARD="$(json_int guard_tokens "$LOCAL_ENTRY")"
fi
if [ -n "$CONTRACT_COMPACT" ] && [ -n "$CONTRACT_GUARD" ] \
   && [ "$CONTRACT_COMPACT" -gt 0 ] && [ "$CONTRACT_GUARD" -ge "$CONTRACT_COMPACT" ]; then
  if [ -z "$CTX_WINDOW" ]; then
    CTX_WINDOW="$CONTRACT_COMPACT"
    ok "Context contract: client compact $CTX_WINDOW / gateway guard $CONTRACT_GUARD"
  elif [ "$CTX_WINDOW" -gt "$CONTRACT_COMPACT" ]; then
    err "REMOTE_CTX=$CTX_WINDOW vượt client_compact_threshold=$CONTRACT_COMPACT của gateway."
    exit 2
  fi
else
  if [ -z "$CTX_WINDOW" ]; then
    CTX_WINDOW="$CONTEXT_FALLBACK"
    warn "Gateway không công bố context_contract; dùng fallback $CTX_WINDOW và không coi là contract-verified."
  else
    warn "Không đọc được context_contract; giữ REMOTE_CTX=$CTX_WINDOW theo explicit override."
  fi
fi
validate_ctx "$CTX_WINDOW"

# Show WHICH model is actually behind the alias, resolved now from the server. $MODEL stays
# "local" everywhere we SEND — the alias is why switching the backend never means editing a
# client — so without this the banner can only ever say "local" and you cannot tell from here
# which backend model is actually live.
# NOTE, honestly: this is a CONNECT-TIME snapshot. If the box switches mid-session this line is
# stale — it cannot self-update, it is a printed banner. The `local` alias means the session
# keeps working (it just talks to the new model); only the label goes out of date. The web UI
# (chat.dongnh.dev) re-resolves every 20s and is the live view.
# /status, not /v1/models: the gateway advertises the alias FIRST in /v1/models on purpose, so
# data[0].id is literally "local" and could never show the real model.
resolve_live_model() {
  curl -s -m 4 -H "Authorization: Bearer $KEY" "$BASE/status" 2>/dev/null \
    | sed -n 's/.*"model"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}
# Canonical SHORT display name for the live-model banner (DISPLAY ONLY — routing is untouched).
short_live_model() {
  case "$1" in
    fritskarl--Qwopus3.6-35B-A3B-Coder-oQ4-mtp)       printf 'Qwopus3.6-35B-A3B-Coder' ;;
    Shiftedx--ornith-1.5-35b-a3b-abliterated-attention8-bf16recurrence-vision-mtplx-512K) printf 'Ornith-1.5-Abliterated-512K' ;;
    Shiftedx--ornith-1.5-35b-a3b-abliterated-attention8-bf16recurrence-vision-mtplx) printf 'Ornith-1.5-Abliterated' ;;
    ivanfioravanti--Qwen3.8-Flash-Next-DS4-IQ2)       printf 'Qwen3.8-Flash-Next-IQ2' ;;
    ivanfioravanti--Qwen3.8-Flash-Next-DS4-IQ2-512K)  printf 'Qwen3.8-Flash-Next-IQ2-512K' ;;
    *--*) printf '%s' "${1##*--}" ;;   # drop leading "vendor--"
    */*)  printf '%s' "${1##*/}" ;;    # drop leading "org/"
    *)    printf '%s' "$1" ;;
  esac
}
LIVE_MODEL="$(resolve_live_model)"
# Over the tunnel /status is closed; /v1/models' `local` entry names the served model instead.
[ -n "$LIVE_MODEL" ] || LIVE_MODEL="$(json_str_field served_model "$LOCAL_ENTRY")"
# /v1/models answers 200 even when the model backend is down (the gateway is up); the first turn would
# then 503 — a `local` request does not start a stopped ds4 process. Say so before the session opens.
case "$LOCAL_ENTRY" in
  *'"backend_reachable": false'*|*'"backend_reachable":false'*)
    warn "Gateway lên nhưng backend model CHƯA chạy — lượt đầu có thể 503. Chờ watchdog dựng lại, hoặc bật từ Dashboard." ;;
esac
if [ -n "$LIVE_MODEL" ]; then
  ok "Kết nối AI local qua $BASE  ·  gửi model: $MODEL  →  đang chạy: $(short_live_model "$LIVE_MODEL")"
else
  ok "Kết nối AI local qua $BASE  ·  model: $MODEL  (không đọc được model thật — /status không mở qua đường này)"
fi

need() { command -v "$1" >/dev/null 2>&1; }

# OpenCode receives its provider through OPENCODE_CONFIG_CONTENT. Keep the API key in the
# environment (rather than in the generated JSON) and let OpenCode resolve {env:...}; this keeps
# the key out of argv/process listings while still allowing a fresh key on every invocation.
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

# The public OpenAI model list is the remote-safe catalog. `/runtimes` is deliberately
# localhost-only, so a client must not treat a 403 there as "there are no models". The response
# contains exact backend ids; the alias and sidecars are removed, and a namespaced id is dropped
# only when its bare twin is also advertised. Output is `<id>\t<label>\tkind`.
# Nemotron 3.5 Lightning is NOT in the lineup any more (no registry entry, route or profile; the gateway
# rewrites an unknown id to `local`). short_name keeps its label branch only so an old catalog row would
# still read cleanly; nothing recommends the id (the PowerShell help did until 2026-09-29).
gateway_model_rows() {
  curl -s -m 12 -H "Authorization: Bearer $KEY" "$BASE/v1/models" 2>/dev/null \
    | /usr/bin/python3 -c '
import json, sys
# Uniform picker label: Provider-Model (the " . thinking ON/OFF" suffix is added downstream).
# Provider comes from /v1/models owned_by (omlx=Local, OCI/Agnes/OpenRouter=cloud provider);
# the short model name is a stable human label, NOT the raw id. No single quotes below — this
# whole block runs inside a single-quoted shell -c.
try:
    data = [it for it in (json.load(sys.stdin).get("data") or []) if isinstance(it, dict)]
except Exception:
    raise SystemExit
ids = [it.get("id", "") for it in data]
id_set = set(ids)

def provider_tag(owned):
    o = (owned or "").lower()
    if "oci" in o: return "OCI"
    if "agnes" in o: return "Agnes"
    if "openrouter" in o: return "OpenRouter"
    if "omlx" in o or "gateway" in o or o in ("ds4", "mlx", "optiq-mlx") or not o: return "Local"
    return (owned or "Local").split()[0]

# Canonical SHORT display names (DISPLAY ONLY — the send-id `mid` is never changed). Explicit map
# wins; unknown Local models fall back to _short_fallback. Mandatory short-name rule.
_SHORT_MAP = {
    "fritskarl--qwopus3.6-35b-a3b-coder-oq4-mtp": "Qwopus3.6-35B-A3B-Coder",
    "shiftedx--ornith-1.5-35b-a3b-abliterated-attention8-bf16recurrence-vision-mtplx": "Ornith-1.5-Abliterated",
    "shiftedx--ornith-1.5-35b-a3b-abliterated-attention8-bf16recurrence-vision-mtplx-512k": "Ornith-1.5-Abliterated-512K",
    "ivanfioravanti--qwen3.8-flash-next-ds4-iq2": "Qwen3.8-Flash-Next-IQ2",
    "ivanfioravanti--qwen3.8-flash-next-ds4-iq2-512k": "Qwen3.8-Flash-Next-IQ2-512K",
}
_SUFFIX_TOKENS = ("vision","mtplx","mtp","mxfp4","oq4e-mtp","oq4-mtp","oq6e","oq4e","oq4","4bit","8bit","mlx","distilled")

def _short_fallback(mid):
    s = mid.split("--", 1)[1] if "--" in mid else (mid.split("/", 1)[1] if "/" in mid else mid)
    changed = True
    while changed:
        changed = False
        for t in _SUFFIX_TOKENS:
            if s.lower().endswith("-" + t):
                s = s[:-(len(t) + 1)]; changed = True; break
    s = s.strip("- ")
    return s or (mid.split("--")[-1] if "--" in mid else mid.rsplit("/", 1)[-1])

def short_name(prov, mid):
    low = mid.lower()
    if low in _SHORT_MAP: return _SHORT_MAP[low]
    if prov == "Local":
        if "qwopus3.8" in low: return "Qwopus3.8-27B-Flash"
        if "qwopus3.6" in low: return "Qwopus3.6-35B-A3B-Coder"
        if "ornith" in low: return "Ornith-1.5-Abliterated"
        if "nemotron" in low: return "Nemotron"
        if "qwen3.6" in low and "35b" in low: return "Qwen3.6-35B"
        if "qwen3.8" in low: return "Qwen3.8-27B"
        return _short_fallback(mid)
    base = mid
    if "/" in base:
        base = base.split("/", 1)[1]            # OpenRouter "nvidia/nemotron-...:free" -> "nemotron-...:free"
    elif base.lower().startswith("openai."):
        base = base[len("openai."):]            # OCI "openai.gpt-oss-120b" -> "gpt-oss-120b"
    elif base.lower().startswith("agnes-"):
        base = base[len("agnes-"):]             # Agnes "agnes-2.5-flash" -> "2.5-flash"
    return base

# Which LOCAL models actually read reasoning_effort in their chat_template. ONLY these get the
# xhigh/medium/low variants; every other local model silently ignores the effort kwarg, so offering
# it would be a lie the user then has to debug. Substring allowlist, updated when a template is
# patched. If it ever grows, move it to a gateway capability in /v1/models so each client does not
# keep its own copy (the drift trap this repo keeps paying for).
# 2026-09-14: DS4 IQ2 (Qwen3.8-Flash-Next) joins, and this entry is NOT a guess. Evidence, three doors:
# (1) the GGUF artifact itself — its tokenizer.chat_template reads the reasoning_effort kwarg with an
# xhigh default and supports exactly xhigh/medium/low, the three this picker emits; (2) strings on the
# ds4-server binary; (3) live on the resident model, same prompt: -think-low gave 86/106 thinking chars,
# -think-xhigh gave 177, identical answer. No single quotes anywhere in this comment: this python runs
# inside a shell single-quoted string, so an apostrophe here would cut the string and break the script.
# ⚠ The template RAISES for any level outside those three, so -high / -moderate / -minimal must NEVER
# be offered for this model — the gateway EFFORT_ALIAS_SUFFIXES accepts them, so the picker is the only
# thing standing between a caller and a 400.
EFFORT_SUBSTRINGS = ("mxfp4", "flash-next")

for it in data:
    mid = it.get("id", "")
    low = mid.lower()
    if not mid or mid == "local" or "drafter" in low or "-vl-" in low:
        continue
    if "--" in mid and mid.split("--", 1)[1] in id_set:
        continue
    prov = provider_tag(it.get("owned_by"))
    if prov != "Local":
        kind = "cloud"                            # reasoning is the cloud provider own concern
    elif any(s in low for s in EFFORT_SUBSTRINGS):
        kind = "local-effort"                     # template reads reasoning_effort
    else:
        kind = "local"                            # local think ON/OFF only, no effort knob
    print("%s\t%s-%s\t%s" % (mid, prov, short_name(prov, mid), kind))
'
}

# Claude Code, Codex, and OpenCode all use the same gateway model contract. An interactive shell
# gets the exact catalog plus local thinking aliases; CI/headless calls and REMOTE_MODEL keep the
# historical non-interactive behaviour. Pressing Return deliberately keeps the stable `local`
# alias, so a temporary catalog failure never silently switches the model.
# Dynamic per-model context (2026-08-25): a cloud model advertises its own context_length in
# /v1/models (Ox Alpha 1,048,576 · Agnes 512K · gpt-oss 128K...). Size the client window to THAT
# instead of the local gateway contract, so a big-context model is not compacted at the local ~57K.
# Local models advertise no context_length → CTX_WINDOW keeps the /status contract value.
apply_model_context_window() {
  local base mctx hr=16384 s
  # Strip EVERY think/effort suffix, not only the two this line knew about. Same list as
  # warm_local_model above — two copies of one rule,
  # which is the drift the comment at EFFORT_SUBSTRINGS says this repo keeps paying for. A leftover
  # suffix cannot match any catalog id, so the lookup finds nothing, CTX_WINDOW silently keeps the
  # LOCAL contract value, and the client compacts at the local threshold against a model that
  # advertises far more — the failure is silent and looks like "the model just compacts early".
  base="$MODEL"
  for s in -nothink -think-xhigh -think-high -think-medium -think-low -think; do base="${base%"$s"}"; done
  if [ -z "$base" ] || [ "$base" = "local" ]; then return 0; fi
  mctx="$(curl -s -m 6 -H "Authorization: Bearer $KEY" "$BASE/v1/models" 2>/dev/null \
    | /usr/bin/python3 -c '
import json, sys
want = sys.argv[1]
try:
    for m in (json.load(sys.stdin).get("data") or []):
        if isinstance(m, dict) and m.get("id") == want:
            c = m.get("context_length")
            if isinstance(c, int) and c > 0: print(c)
            break
except Exception:
    pass
' "$base" 2>/dev/null)"
  if [ -n "$mctx" ] && [ "$mctx" -gt 0 ] 2>/dev/null; then
    CTX_WINDOW=$(( mctx > hr ? mctx - hr : mctx ))    # headroom for est-error + next turn
    ok "Model $MODEL context ${mctx} → window động ${CTX_WINDOW} token (bỏ cap local)"
  fi
}

# Proactively make a picked EXACT local model resident BEFORE the agent CLI starts, so the first
# real turn is not a ~30s cold hot-swap the user waits through blind — "load tự động cho local,
# khỏi phải build tay". The gateway already swaps oMLX on the FIRST request that carries an exact
# id (gateway/server.py `_omlx_switch` → providers.ensure_model_loaded, reachable via the edge);
# this just FIRES that swap now, with a visible wait, instead of hiding it inside the user's first
# message. Only an exact omlx id (org--name) can trigger a switch: the stable `local` alias and
# every cloud id already serve without a load, so they are skipped (a cloud API is always warm —
# that is the asymmetry the user is closing). Degrades soft: a failed warm just means the first
# turn pays the cold swap exactly as before, so a busy/unreachable box never blocks the launch.
warm_local_model() {
  local m="${1:-}" bare s code
  is_local_model "$m" || return 0                   # cloud pick: nothing to load on the box
  case "$m" in *--*) ;; *) return 0 ;; esac         # `local` / `local-*` alias IS the resident model
  bare="$m"                                          # strip our think/effort suffix → the exact send-id
  for s in -nothink -think-xhigh -think-high -think-medium -think-low -think; do bare="${bare%"$s"}"; done
  echo
  # The box holds ONE big model. An exact id that is not the served one is a SWITCH for everyone:
  # the other model is freed and `local` repoints to this one for every user until someone switches
  # back — and a ds4 switch can take 60 s to stop plus up to 180 s to start (gateway/providers/ds4.py).
  if [ -n "${LIVE_MODEL:-}" ] && [ "$bare" != "$LIVE_MODEL" ]; then
    warn "Chọn $(short_live_model "$bare") sẽ ĐỔI model cho CẢ box: $(short_live_model "$LIVE_MODEL") bị gỡ,"
    warn "  \`local\` trỏ sang model mới cho MỌI người dùng; đổi có thể mất 1-4 phút."
    printf 'Tiếp tục đổi? [y/N] '
    local yn=""
    read -r yn || yn=""
    case "$yn" in
      y|Y|yes|YES) ;;
      *) dim "  Giữ model đang chạy — phiên sẽ gửi đích danh $bare; lượt đầu mới đổi (nếu vẫn chọn)."; return 0 ;;
    esac
  fi
  ok "Nạp model local lên box: $bare"
  dim "  (có thể mất 1-4 phút nếu phải đổi model; cloud không cần bước này — box chỉ giữ 1 model một lúc)"
  # A 1-token non-stream completion forces the resident swap through the exact-id path. On loopback
  # nothing cuts it early, so wait out a full ds4 stop + start; through Cloudflare the edge may cut a
  # request that sends no bytes for ~100 s — the switch still completes on the box, and the first
  # turn then finds it resident.
  code="$(curl -s -m 300 -o /dev/null -w '%{http_code}' \
    -H "Authorization: Bearer $KEY" -H "Content-Type: application/json" \
    -X POST "$BASE/v1/chat/completions" \
    --data-binary "{\"model\":\"$bare\",\"messages\":[{\"role\":\"user\",\"content\":\"warmup\"}],\"max_tokens\":1,\"stream\":false}" \
    2>/dev/null || true)"
  case "$code" in
    200) ok "Model local sẵn sàng: $bare" ;;
    000) warn "Không gọi được gateway để nạp — lượt đầu sẽ tự nạp (chậm hơn)." ;;
    *)   warn "Chưa nạp được (HTTP $code) — lượt đầu sẽ tự nạp (chậm hơn)." ;;
  esac
}

select_agent_model() {
  [ "$MODEL_PINNED" -eq 1 ] && return 0
  [ -t 0 ] || return 0
  local rows choices choice send disp n=0 tab
  rows="$(gateway_model_rows)"
  if [ -z "$rows" ]; then
    warn "Không đọc được catalog model gateway — giữ alias local. Dùng REMOTE_MODEL=<id> để chọn rõ."
    return 0
  fi
  # Expand rows into ordered choice lines "send_id<TAB>display" ONCE. The numbered menu below and the
  # selection both index THIS single list, so what is shown and what is sent can never drift apart —
  # they were two hand-kept copies before, which is exactly how cloud models got local -think/-effort
  # suffixes and effort-less local models got xhigh/medium/low. Per kind:
  #   local-effort → thinking ON·xhigh / medium / low / OFF   (template reads reasoning_effort)
  #   local        → thinking ON / OFF                        (no effort knob; bare ON = env default)
  #   cloud        → bare id                                  (reasoning is the provider own concern)
  choices="$(printf '%s\n' "$rows" | /usr/bin/python3 -c '
import os, sys
tab = "\t"
local_only = os.environ.get("SELECT_LOCAL_ONLY") == "1"   # workflow (menu 6) runs the LOCAL model only
out = []
for line in sys.stdin:
    p = line.rstrip("\n").split(tab)
    if len(p) < 3:
        continue
    mid, label, kind = p[:3]
    if kind == "local-effort":
        out.append((mid + "-think-xhigh",  label + " · thinking ON · xhigh"))
        out.append((mid + "-think-medium", label + " · thinking ON · medium"))
        out.append((mid + "-think-low",    label + " · thinking ON · low"))
        out.append((mid + "-nothink",      label + " · thinking OFF"))
    elif kind == "local":
        out.append((mid + "-think",   label + " · thinking ON"))
        out.append((mid + "-nothink", label + " · thinking OFF"))
    elif not local_only:
        out.append((mid, label))
for sid, disp in out:
    print(sid + tab + disp)
')"
  [ -z "$choices" ] && { warn "Không dựng được danh sách model."; return 0; }
  echo
  bold "Chọn model gateway cho phiên agent"
  echo "  Enter) local (alias ổn định, model đang active)"
  tab="$(printf '\t')"
  while IFS="$tab" read -r send disp; do
    [ -z "$send" ] && continue
    n=$((n + 1))
    printf '  %d) %s\n' "$n" "$disp"
  done <<< "$choices"
  while :; do
    printf '› '
    read -r choice || { echo; return 0; }
    [ -z "$choice" ] && return 0
    case "$choice" in
      *[!0-9]*) warn "Nhập số trong danh sách hoặc Enter."; continue ;;
    esac
    [ "$choice" -gt 0 ] 2>/dev/null || { warn "Lựa chọn không hợp lệ."; continue; }
    send="$(printf '%s\n' "$choices" | sed -n "${choice}p" | cut -f1)"
    if [ -n "$send" ]; then
      MODEL="$send"
      MODEL_PINNED=1
      ok "Đã chọn model: $MODEL"
      warm_local_model "$MODEL"   # auto-load a specific local model now, not on the first turn
      return 0
    fi
    warn "Lựa chọn không hợp lệ."
  done
}

run_status() {
  # /v1/models 200 CHƯA chắc decode sống (đã gặp wedge) — sinh thử 4 token thật.
  echo
  dim "Decode canary (sinh 4 token thật, có thể chờ nếu model đang bận)…"
  t0=$(date +%s)
  code="$(curl -s -m 120 -o /dev/null -w '%{http_code}' -X POST \
    -H "Authorization: Bearer $KEY" -H 'Content-Type: application/json' \
    -d "{\"model\":\"$MODEL\",\"max_tokens\":4,\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}" \
    "$BASE/v1/chat/completions" 2>/dev/null)"
  dt=$(( $(date +%s) - t0 ))
  if [ "$code" = "200" ]; then
    ok "AI SỐNG và decode được (${dt}s)."
  else
    err "Decode hỏng (HTTP $code sau ${dt}s) — server có thể đang kẹt; watchdog trên Mac chủ sẽ tự phục hồi trong ~6 phút, thử lại sau."
    exit 1
  fi
}

# ── Batch runner for `### Task` plans (menu 6) ──────────────────────────────────────────────────────
# Runs a multi-task plan unattended: each task is a FRESH `claude -p` turn, graded by the plan's OWN
# test, which the driver writes and freezes before the implementer runs (no self-graded false green);
# state lives on disk, so a stopped run resumes. Local models run without sub-agents (one decode slot),
# so this is how they get a fresh context per task plus frozen tests. The three tools are materialised
# with NO manual copy: the built .command carries them embedded (wf_emit_batch_tools, injected by
# build-remote-command.sh); a source checkout copies them from tools/local-workflow.
WF_RULES_DIR="${REMOTE_WF_DIR:-$HOME/.remote-workflow}"
WF_TOOLS="wf_ui.py run_tasks.py tasks_gen.py"
wf_write_batch_tools() {
  local f
  mkdir -p "$WF_RULES_DIR" 2>/dev/null || true
  if command -v wf_emit_batch_tools >/dev/null 2>&1; then
    wf_emit_batch_tools "$WF_RULES_DIR"
  else
    local src="$SELF_DIR/../tools/local-workflow"
    if [ -r "$src/run_tasks.py" ]; then
      for f in $WF_TOOLS; do cp -f "$src/$f" "$WF_RULES_DIR/" 2>/dev/null || true; done
    else
      err "Không tìm batch tools (wf_emit_batch_tools/$src) — dùng bản remote-client.command đã build."
      return 1
    fi
  fi
  for f in $WF_TOOLS; do [ -r "$WF_RULES_DIR/$f" ] || return 1; done
}

# Best-effort end-grade guess from the repo's shape, so the user rarely types GRADE by hand. Prints a
# runnable command or nothing. It is only a SUGGESTED default (the caller lets the user accept/override).
wf_detect_grade() {
  local r="$1"
  if [ -f "$r/grade.sh" ]; then echo "bash grade.sh"; return; fi
  if [ -f "$r/Cargo.toml" ]; then echo "cargo test"; return; fi
  if [ -f "$r/pyproject.toml" ] || [ -f "$r/pytest.ini" ] || [ -f "$r/setup.cfg" ]; then
    echo "python3 -m pytest -q"; return
  fi
  if [ -f "$r/package.json" ] && grep -q '"test"[[:space:]]*:' "$r/package.json" 2>/dev/null; then
    echo "npm test --silent"; return
  fi
  if [ -f "$r/go.mod" ]; then echo "go test ./..."; return; fi
  if [ -f "$r/Makefile" ] && grep -qE '^test:' "$r/Makefile" 2>/dev/null; then echo "make test"; return; fi
  echo ""
}

# Launcher, NOT another model picker: the model comes from the LOCAL-only picker, REPO is the current
# directory, and the only input is the task. Both routes end in run_tasks.py:
#   gen   — a feature description → tasks_gen drafts a `### Task` plan (self-checked by run_tasks' own
#           parser) → review gate → run it;
#   tasks — an existing plan file with `### Task` blocks → run it.
# REMOTE_WF_MODE=gen|tasks forces the route; GRADE / MODEL are env overrides.
run_workflow() {
  need claude   || { err "Batch runner cần Claude Code: npm install -g @anthropic-ai/claude-code"; exit 1; }
  need python3  || { err "Batch runner cần python3."; exit 1; }
  wf_write_batch_tools || exit 1
  local repo task="" state _m _go
  local wf_mode="${REMOTE_WF_MODE:-}" is_task_plan=0
  case "$wf_mode" in
    gen|tasks|"") ;;
    *) err "REMOTE_WF_MODE=$wf_mode không còn (chế độ fix-1-bug đã bỏ 2026-10-06) — dùng gen hoặc tasks."
       return 1 ;;
  esac
  # LOCAL-only picker (SELECT_LOCAL_ONLY=1): this runner is for the home models, which run without
  # sub-agents; a cloud model can use Claude Code's own sub-agent workflow instead.
  export SELECT_LOCAL_ONLY=1; select_agent_model; unset SELECT_LOCAL_ONLY
  # Resolve the picked model's window and EXPORT it so the drivers size each fresh `claude -p` step
  # (CLAUDE_CODE_MAX_CONTEXT_TOKENS / AUTO_COMPACT_WINDOW): a step starts fresh, but ONE step still
  # grows with tool use and has to compact before the gateway guard.
  apply_model_context_window; export CTX_WINDOW
  repo="$(pwd -P)"
  # THIS repo's state dir, asked from the one owner of the slug (run_tasks), so the two never disagree.
  state="$(REPO="$repo" python3 "$WF_RULES_DIR/run_tasks.py" --print-state-dir 2>/dev/null)"
  if [ "$#" -gt 0 ]; then
    task="$*"
  elif [ -n "$wf_mode" ]; then
    printf 'Task/mô tả (mode=%s): ' "$wf_mode"; read -r task || { echo; return 0; }
  else
    echo; bold "Batch workflow — chọn cách chạy:"
    dim  "REPO=$repo · model=$MODEL · gateway=$BASE"
    printf '%s\n' \
      "  [1] Mô tả TÍNH NĂNG → tự sinh plan nhiều-task rồi chạy   (tasks_gen, khuyên dùng)" \
      "  [2] Chạy FILE plan có sẵn (### Task)                     (run_tasks)" \
      "  [Q] Quản lý task đã chạy trên repo (xem · chạy tiếp · reset)"
    printf 'Chọn [1/2/Q] (Enter=1): '
    read -r _m || { echo; return 0; }
    case "$_m" in
      2)    wf_mode=tasks; printf 'Đường dẫn file plan (### Task): '; read -r task || { echo; return 0; } ;;
      [Qq]) env REPO="$repo" GW="$BASE" MODEL="$MODEL" AI_GATEWAY_KEY="$KEY" \
              ANTHROPIC_API_KEY="$KEY" ANTHROPIC_AUTH_TOKEN="$KEY" \
              CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 \
              python3 "$WF_RULES_DIR/run_tasks.py" --manage
            return ;;
      *)    wf_mode=gen;   printf 'Mô tả tính năng: ';              read -r task || { echo; return 0; } ;;
    esac
  fi
  [ -n "$task" ] || { err "Chưa nhập task."; return 1; }
  # A plan FILE with >=1 `### Task` goes to the per-task driver; anything else is a feature request.
  if [ "$wf_mode" != gen ] && [ -f "$task" ] && grep -qE '^###[[:space:]]+Task[[:space:]]' "$task" 2>/dev/null; then
    is_task_plan=1
  fi
  if [ "$wf_mode" = tasks ]; then
    [ -f "$task" ] || { err "REMOTE_WF_MODE=tasks nhưng TASK không phải file plan: $task"; return 1; }
    is_task_plan=1
  fi
  if [ "$is_task_plan" != 1 ]; then
    wf_mode="${wf_mode:-gen}"
    # A spec file without `### Task` blocks is a feature request too: point the planner at it.
    [ -f "$task" ] && task="Implement the spec in $task (read that file first)."
  fi
  # Auto-detect the end grade so the user rarely types it (asked 2026-09-09: "tự động, đừng bắt làm tay").
  # One keypress: Enter accepts the detected command, "-" skips, or type another. Skipped when GRADE is
  # already set.
  if [ -z "${GRADE:-}" ]; then
    local _g; _g="$(wf_detect_grade "$repo")"
    if [ -n "$_g" ]; then
      printf 'GRADE cuối (Enter=%s · "-"=bỏ · hoặc gõ lệnh test khác): ' "$_g"
      read -r _gin || _gin=""
      case "$_gin" in "") GRADE="$_g" ;; "-") GRADE="" ;; *) GRADE="$_gin" ;; esac
      [ -n "$GRADE" ] && dim "→ end grade: $GRADE"
    fi
  fi
  # gen: TASK is a FEATURE REQUEST (free text) → tasks_gen turns it into a `### Task` plan (the model
  # returns FACTS, code assembles the shape, self-checked by run_tasks' own parser), then after a review
  # gate it runs. This is the "I don't want to hand-author plans" path.
  if [ "$wf_mode" = gen ]; then
    local gout="${state:-$HOME/.remote-workflow/gen}"
    echo; ok "Sinh plan từ mô tả tính năng → $BASE"
    dim "tasks_gen: model trả FACTS, code dựng ### Task, tự kiểm round-trip bằng parser THẬT của run_tasks."
    env REPO="$repo" FEATURE="$task" OUT="$gout" GW="$BASE" MODEL="$MODEL" \
        AI_GATEWAY_KEY="$KEY" ANTHROPIC_API_KEY="$KEY" ANTHROPIC_AUTH_TOKEN="$KEY" \
        CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 \
        ${GRADE:+GRADE="$GRADE"} ${REMOTE_WF_LANG:+WF_LANG="$REMOTE_WF_LANG"} \
        python3 "$WF_RULES_DIR/tasks_gen.py" --print \
      || { err "Sinh plan thất bại/round-trip đỏ (xem trên) — không chạy."; return 1; }
    task="$gout/plan.md"
    [ -f "$task" ] || { err "Không thấy plan sinh ra: $task"; return 1; }
    printf 'Enter = CHẠY plan vừa sinh · Ctrl-C = dừng để xem/sửa (%s): ' "$task"
    read -r _go || { echo; return 0; }
  fi
  # Each `### Task` is graded with the PLAN's OWN test, frozen against the implementer, instead of a
  # test the model wrote for itself (false green measured 2026-09-08).
  echo; ok "Per-task workflow → $BASE"
  dim "Mỗi ### Task chấm bằng test của CHÍNH plan (đóng băng khỏi model). State + REPORT.md/REPORT.html theo repo, resume được lần sau. Ctrl-C để dừng."
  [ -n "${GRADE:-}" ] || dim "Muốn dấu PASS/FAIL thật ở cuối: chạy lại với GRADE=\"<lệnh test tổng>\" (vd GRADE=\"cargo test\" hoặc GRADE=\"bash grade.sh\")."
  env REPO="$repo" TASK_PLAN="$task" GW="$BASE" MODEL="$MODEL" \
      AI_GATEWAY_KEY="$KEY" ANTHROPIC_API_KEY="$KEY" ANTHROPIC_AUTH_TOKEN="$KEY" \
      CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1 \
      ${GRADE:+GRADE="$GRADE"} \
      ${REMOTE_WF_LANG:+WF_LANG="$REMOTE_WF_LANG"} \
      python3 "$WF_RULES_DIR/run_tasks.py"
}

# Is the picked model the LOCAL home model (vs a cloud provider routed through the gateway)? Our
# workflow discipline + superpowers skillOverride are for the small local model ONLY; a cloud model
# picked through this launcher must be left exactly as it is (the user's rule: "cloud không cần").
# The picker only ever attaches our think/effort suffixes to local rows and leaves cloud ids bare
# (gateway_model_rows kind), and omlx exact ids carry `org--name`; a cloud id is bare or has `/`.
is_local_model() {
  case "$1" in
    local|local-*) return 0 ;;                                                # alias + think/effort variants
    *-think|*-nothink|*-think-xhigh|*-think-medium|*-think-low) return 0 ;;   # our suffix rides local only
    */*) return 1 ;;                                                          # OpenRouter-style cloud id
    *--*) return 0 ;;                                                         # omlx exact id (org--name)
    *) return 1 ;;                                                            # bare cloud id (openai.*, agnes-*, *-flash)
  esac
}

# Map the picked LOCAL alias to Claude Code's own --effort (low/medium/high/xhigh/max) so the CLIENT
# sends the SAME effort the alias asks for. Measured 2026-09-08: a `-think-medium` pick still ran an
# 8-minute think on a 1043-token prompt that pinned the single decode slot and 429'd everything else.
# DEFAULT medium (user decision: xhigh over-thinks interactive turns). -nothink → emit nothing.
# Since 2026-10-04 the gateway forwards Claude Code's output_config.effort (compat.apply_client_effort)
# with precedence alias > client effort > MLX_AGENT_REASONING_EFFORT, so a plain `local` pick really
# runs at this medium; before that the gateway dropped the field and the env default (xhigh) applied.
effort_of_model() {
  case "$1" in
    *-nothink)      return 0 ;;
    *-think-xhigh)  printf xhigh ;;
    *-think-high)   printf high ;;
    *-think-medium) printf medium ;;
    *-think-low)    printf low ;;
    *)              printf medium ;;   # local / -think / bare local default → medium
  esac
}

# Session choice for Claude Code / Codex (user 2026-10-06: the menu had no way to resume an old session).
# Sets SESSION_MODE to new | continue | resume. REMOTE_SESSION answers without a keyboard; with no answer
# and no TTY (tests, pipes) it is "new", so nothing waits on a prompt nobody can see. Both clients keep
# their sessions per working directory, so "continue"/"resume" see the sessions of the folder shown above.
pick_session_mode() {
  local m="${REMOTE_SESSION:-}"
  if [ -z "$m" ] && [ -t 0 ]; then
    printf 'Phiên: [Enter] mới · c) tiếp phiên gần nhất · r) chọn phiên cũ › ' >&2
    read -r m || m=""
  fi
  case "$m" in
    c|C|continue) SESSION_MODE=continue ;;
    r|R|resume)   SESSION_MODE=resume ;;
    *)            SESSION_MODE=new ;;
  esac
}

run_claude() {
  need claude || { err "Chưa cài Claude Code: npm install -g @anthropic-ai/claude-code"; exit 1; }
  select_agent_model
  apply_model_context_window
  echo; ok "Mở Claude Code (→ $BASE)"
  dim "Lưu ý: server chặn input quá ~${CTX_WINDOW} token (trả 400) — gặp thì /compact."
  # Mặc định bỏ hỏi quyền từng tool (Read/Edit/Bash…) — đây là client nội bộ
  # trỏ AI nhà, hỏi từng cái rất phiền. Muốn bật lại hỏi quyền: REMOTE_SAFE=1.
  # PHẢI đặt comment + skip TRƯỚC khối env: một comment chen GIỮA các dòng nối
  # `\` sẽ nuốt cả khối (backslash-newline nối vào dòng comment) → exec claude
  # chạy KHÔNG có ANTHROPIC_* → Claude Code âm thầm gọi api.anthropic.com.
  # A session flag the user typed wins. Minimal mode runs --no-session-persistence, so there is nothing
  # to resume there.
  SESSION_MODE=new
  local _a
  for _a in "$@"; do
    case "$_a" in -c|--continue|-r|--resume|--resume=*|--session-id|--session-id=*) SESSION_MODE=given ;; esac
  done
  if [ "$SESSION_MODE" = new ] && [ "$REMOTE_CLAUDE_MINIMAL" != 1 ]; then pick_session_mode; fi
  local claude_args=(--model "$MODEL")
  [ -z "$REMOTE_SAFE" ] && claude_args+=(--dangerously-skip-permissions)
  local claude_env=(
    "ANTHROPIC_BASE_URL=$BASE"
    "ANTHROPIC_API_KEY=$KEY"
    "ANTHROPIC_AUTH_TOKEN=$KEY"
    "DISABLE_LOGIN_COMMAND=1"
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"
    "DISABLE_AUTOUPDATER=1"
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1"
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1"
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS=$CTX_WINDOW"
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT=1"
  )
  # AUTO_COMPACT_WINDOW is the knob that decides WHEN Claude Code auto-compacts; MAX_CONTEXT_TOKENS
  # alone leaves the trigger on Claude's 200K assumption, so a local session compacts far too late and
  # thrashes (user 2026-09-08). Set it for LOCAL models in EVERY mode — minimal AND default — tracking
  # /status client_compact_threshold ($CTX_WINDOW). Cloud models are excluded: Claude already knows
  # their real window. This is window management, orthogonal to the "vanilla NORMAL mode" decision
  # (which removed workflow-rule injection + skillOverride, not the window that MAX_CONTEXT_TOKENS
  # already bounded in default mode).
  is_local_model "$MODEL" && claude_env+=("CLAUDE_CODE_AUTO_COMPACT_WINDOW=$CTX_WINDOW")
  # Claude Code's background session-title request lands on the ONE local decode slot, thinks, and gets
  # the real first request shed with 429 while it runs (2026-10-06: 676 thinking tokens for an 11-token
  # title, 16.9 s). Local models only; a cloud pick keeps its title.
  is_local_model "$MODEL" && claude_env+=("CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1")
  if [ "$REMOTE_CLAUDE_MINIMAL" = 1 ]; then
    dim "Claude local minimal mode: automatic memory/customizations disabled; prompt must provide CLAUDE.md context."
    local minimal_system_prompt="You are Claude Code in a trusted local coding worktree. First inspect and obey CLAUDE.md and repository instructions. Use only the available Read, Edit, Bash, Glob, and Grep tools. Keep changes focused, run targeted tests, and report exact commands and results. Never claim success without evidence."
    claude_env+=(
      "CLAUDE_CODE_DISABLE_AUTO_MEMORY=1"
      "CLAUDE_CODE_DISABLE_ATTACHMENTS=1"
      "CLAUDE_CODE_DISABLE_CLAUDE_MDS=1"
      "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS=1"
      "CLAUDE_CODE_DISABLE_CLAUDE_CODE_SKILL=1"
      "CLAUDE_CODE_DISABLE_CLAUDE_API_SKILL=1"
      "CLAUDE_CODE_SKIP_PROJECT_BACKFILL=1"
      "CLAUDE_CODE_SKIP_PROMPT_HISTORY=1"
      # AUTO_COMPACT_WINDOW is set for all LOCAL modes just after the base env block (was minimal-only).
    )
    # Keep the first local request below the gateway ceiling: the default Claude tool catalog is
    # large enough to exceed a 57k local context before the first compaction can run.
    claude_args+=(--bare --no-session-persistence --disable-slash-commands
                  --tools "Bash,Read,Edit,Glob,Grep"
                  --system-prompt "$minimal_system_prompt")
  elif is_local_model "$MODEL"; then
    # NORMAL mode, LOCAL model — interactive is otherwise VANILLA Claude Code (user 2026-09-08:
    # workflow discipline AND the superpowers skillOverride both REMOVED). The ONLY kept fix is
    # --effort (user: "ép effort thì giữ"): Claude Code sends output_config.effort on every request
    # (its own default otherwise), and since 2026-10-04 the gateway forwards it below the alias and
    # above MLX_AGENT_REASONING_EFFORT. effort_of_model maps the pick, default medium; -nothink emits
    # none. The bounded workflow now lives only in menu 6.
    _eff="$(effort_of_model "$MODEL")"; [ -n "$_eff" ] && claude_args+=(--effort "$_eff")
    # A LOCAL gateway serves ONE decode slot; the Task subagent tool fans out parallel calls at it →
    # 429 storms + a crawl (measured in the workflow 2026-09-10, user asked to disable it here too).
    # Disallow it for LOCAL interactive; cloud models don't hit the 1-slot backend so they stay fully
    # vanilla. The --bare path already excludes Task via its --tools whitelist. Override/re-enable:
    # REMOTE_CLAUDE_DISALLOW="" (empty) keeps subagents; REMOTE_CLAUDE_DISALLOW="Task,Foo" adds more.
    _dis="${REMOTE_CLAUDE_DISALLOW-Task}"
    [ -n "$_dis" ] && claude_args+=(--disallowedTools "$_dis")
  fi
  case "$SESSION_MODE" in
    continue) claude_args+=(--continue); dim "Phiên: tiếp phiên gần nhất của thư mục này" ;;
    resume)   claude_args+=(--resume);   dim "Phiên: chọn phiên cũ trong danh sách" ;;
  esac
  exec env "${claude_env[@]}" claude "${claude_args[@]}" "$@"
}

run_codex() {
  need codex || { err "Chưa cài Codex CLI: npm install -g @openai/codex"; exit 1; }
  select_agent_model
  apply_model_context_window
  # Isolate config so we never clobber the client's own ~/.codex (cloud login).
  local ch="$HOME/.cache/claude-local-remote/codex"
  mkdir -p "$ch"
  # `codex resume` / `codex fork` typed by the user wins; otherwise ask (see pick_session_mode).
  SESSION_MODE=new
  case "${1:-}" in resume|fork) SESSION_MODE=given ;; esac
  if [ "$SESSION_MODE" = new ]; then pick_session_mode; fi
  # Local model: window = gateway GUARD (real hard ceiling) + an explicit auto-compact trigger at the
  # client_compact threshold, so Codex compacts ~16K BEFORE overflow. That ordering sidesteps
  # codex#16068 (a custom window that only compacts AFTER overflow poisons the token counter → endless
  # thrash). Cloud models keep the window apply_model_context_window resolved and need no local trigger.
  # model_auto_compact_token_limit is a real key in codex-cli 0.153.0 — verified via
  # `codex --strict-config exec` (a bogus key is rejected with "unknown configuration field"; this is not).
  local codex_window="$CTX_WINDOW" codex_compact_line="" codex_agents_line=""
  if is_local_model "$MODEL"; then
    codex_window="${CONTRACT_GUARD:-$CTX_WINDOW}"
    codex_compact_line="model_auto_compact_token_limit = $CTX_WINDOW"
    # Codex 0.154.0 ships multi_agent ON (stable): a spawn-agent tool whose sub-agents only queue
    # behind their parent on the one-slot local gateway. Off for LOCAL models (user 2026-10-05);
    # REMOTE_CODEX_SUBAGENTS=1 keeps it. Cloud models stay vanilla.
    [ "${REMOTE_CODEX_SUBAGENTS:-}" = "1" ] || codex_agents_line="features.multi_agent = false"
  fi
  cat > "$ch/config.toml" <<TOML
# Auto-generated by remote-client — Codex → remote go-llm-proxy.
model_provider = "glp"
model = "$MODEL"
# Window = gateway guard; compact BELOW it so Codex compacts before the 400 (and before overflow).
model_context_window = $codex_window
${codex_compact_line}
${codex_agents_line}
model_max_output_tokens = 16384
TOML
  # Mặc định miễn duyệt lệnh + mở sandbox (client nội bộ, AI nhà) — muốn codex
  # hỏi trước từng lệnh như mặc định gốc: REMOTE_SAFE=1. Hai key này là
  # TOP-LEVEL nên phải đứng TRƯỚC bảng [model_providers] (TOML: key sau một
  # bảng là chui vào bảng đó).
  if [ -z "$REMOTE_SAFE" ]; then
    cat >> "$ch/config.toml" <<TOML
approval_policy = "never"
sandbox_mode = "danger-full-access"
TOML
  fi
  cat >> "$ch/config.toml" <<TOML

[model_providers.glp]
name = "go-llm-proxy (remote MLX)"
base_url = "$BASE/v1"
env_key = "GLP_KEY"
wire_api = "responses"
TOML
  # Kỷ luật toàn cục cho model local: Codex đọc AGENTS.md trong CODEX_HOME cho
  # MỌI repo — khỏi tạo tay từng repo. Regenerate mỗi lần chạy (như config.toml),
  # muốn sửa nội dung thì sửa Ở ĐÂY chứ đừng sửa file đích.
  cat > "$ch/AGENTS.md" <<AGENTS
# Global agent rules — local LLM via home gateway

These rules apply whenever the model is \`local\` (home MLX gateway, context
**${CTX_WINDOW} tokens**). A repo's own AGENTS.md adds to / overrides this file.

## Before starting in any repo
- If the repo root has **CLAUDE.md**, read it FIRST — repo map, build/verify
  commands, and conventions live there.

## Context discipline (hard limits)
- The context window is ${CTX_WINDOW} tokens. One oversized request gets a hard
  400 — measured: batch-reading ~50 files ≈ 477K tokens = instant failure.
- Read files in SMALL batches (5 or fewer per turn). List directories before
  reading. Never re-read a file already read this session.
- Never read generated/vendored files wholesale (lock files, target/,
  node_modules/, generated protocol files) — grep for the symbol you need.

## Big tasks (whole-repo review, audit, migration)
- Divide and conquer: one module per session; write findings to
  docs/reviews/<module>.md as each part finishes; synthesize at the end.
AGENTS
  echo; ok "Mở Codex (→ $BASE/v1, context ${CTX_WINDOW})"
  # `resume` is a subcommand with its own -m; sessions live in this launcher's fixed CODEX_HOME.
  case "$SESSION_MODE" in
    continue) dim "Phiên: tiếp phiên gần nhất của thư mục này"
              CODEX_HOME="$ch" GLP_KEY="$KEY" exec codex resume -m "$MODEL" --last "$@" ;;
    resume)   dim "Phiên: chọn phiên cũ trong danh sách (thêm --all để xem mọi thư mục)"
              CODEX_HOME="$ch" GLP_KEY="$KEY" exec codex resume -m "$MODEL" "$@" ;;
  esac
  CODEX_HOME="$ch" GLP_KEY="$KEY" exec codex -m "$MODEL" "$@"
}

run_opencode() {
  need opencode || { err "Chưa cài OpenCode: xem https://opencode.ai/docs/ hoặc cài opencode trước"; exit 1; }
  select_agent_model
  apply_model_context_window
  local oc_base oc_config model_name model_key
  model_name="$MODEL"
  model_key="$(json_escape "$model_name")"
  oc_base="$(json_escape "$BASE/v1")"
  # limit.context = the picked model's window (from apply_model_context_window above); opencode uses
  # it for its own near-limit compaction. Schema-valid: opencode config.json models.<id>.limit
  # {context,output} are both required, additionalProperties=false. Without it opencode ignores
  # CTX_WINDOW and uses the SDK default window → a local model gets no compaction and walks past the
  # gateway ceiling into a 400. Applied to every picked model (cloud advertises its own context_length,
  # so CTX_WINDOW is that model's real window either way).
  oc_config="$(printf '{"$schema":"https://opencode.ai/config.json","model":"ai-gateway/%s","provider":{"ai-gateway":{"npm":"@ai-sdk/openai-compatible","name":"AI Gateway Local","options":{"baseURL":"%s","apiKey":"{env:OPENCODE_API_KEY}"},"models":{"%s":{"name":"AI Gateway Local","limit":{"context":%d,"output":16384}}}}}}' "$model_key" "$oc_base" "$model_key" "${CTX_WINDOW:-131072}")"
  echo; ok "Mở OpenCode (→ $BASE/v1, model $MODEL, --auto)"
  # Use the same selected model as Claude and Codex. --auto removes permission prompts for this
  # trusted local gateway session.
  OPENCODE_API_KEY="$KEY" OPENCODE_CONFIG_CONTENT="$oc_config" \
    exec opencode --auto --model "ai-gateway/$model_name" "$@"
}

run_dsh() {
  need npx || { err "DeepSeek Harness cần Node (npx). Cài Node 20+ rồi thử lại."; exit 1; }
  apply_model_context_window   # resolve the PICKED model's window into CTX_WINDOW (no-op for `local`;
                               # dsh_emit_config prefers it over the /status resident-model threshold)
  # Isolated DSH_HOME, same discipline as run_codex: never write into a config the user
  # already owns. A fresh home bootstraps its own profiles/ on first boot (verified
  # 2026-08-17), so this works on a machine that has never run dsh.
  local home="$HOME/.cache/claude-local-remote/dsh-home"
  mkdir -p "$home"
  if [ ! -r "${DSH_PROXY_SCRIPT:-}" ] && command -v dsh_install_embedded_proxy >/dev/null 2>&1; then
    DSH_PROXY_SCRIPT="$home/omlx-single-model-proxy.py"
    export DSH_PROXY_SCRIPT
    dsh_install_embedded_proxy "$DSH_PROXY_SCRIPT"
  fi
  # THE CONFIG IS WRITTEN BY ONE SHARED FUNCTION when it is reachable, and by a minimal inline
  # fallback when it is not. Both halves are load-bearing:
  #
  #  * shared, because dsh-direct.sh needs the same routes and a copied config drifts — the same
  #    failure that shipped a Start button which loaded a second 20 GB model on 2026-08-17.
  #  * fallback, because THIS file is meant to survive being copied alone to another machine
  #    (that is what remote-client.command is for). Sourcing a sibling unconditionally would turn
  #    the single-file property into a lie that only fails on someone else's laptop.
  local lib="$SELF_DIR/lib/dsh-config.sh"
  local omlx_arg="" def_provider="ai-gateway" def_model="local-think"
  if ! command -v dsh_start_single_model_proxy >/dev/null 2>&1 && [ -r "$lib" ]; then
    # The generated single-file client already has the function; the source checkout loads it.
    . "$lib"
  fi
  # oMLX listens on loopback with NO api_key. Offer it only when this script runs ON the box:
  # from elsewhere the address is unreachable, or — if anyone ever exposed it — an
  # unauthenticated model endpoint on the public internet.
  # The direct route talks to oMLX; with another runtime serving (ds4 since 2026-09-28) it would drive
  # an on-demand oMLX slot behind the gateway's back, so it is offered only while oMLX serves. Its
  # proxy port sits OUTSIDE the backend range: 18087 is ds4 Ornith's port, and the proxy used to take
  # it (Ornith then could not start) or fail to bind (the route silently vanished).
  local served_rt; served_rt="$(json_str_field runtime "${LOCAL_ENTRY:-}")"
  case "$BASE" in
    http://127.0.0.1:*|http://localhost:*|http://[::1]:*)
      if [ -n "$served_rt" ] && [ "$served_rt" != "omlx" ]; then
        dim "Box đang phục vụ bằng $served_rt (không phải oMLX) → không chào route oMLX trực tiếp"
      else
        local omlx_upstream="${OMLX_BASE:-http://127.0.0.1:18085}"
        if dsh_start_single_model_proxy "$omlx_upstream" "${OMLX_DIRECT_PROXY_PORT:-18095}" "$home"; then
          omlx_arg="$DSH_PROXY_BASE"
          ok "oMLX direct được khóa one-model qua $omlx_arg"
        else
          dim "Không có direct one-model proxy cạnh launcher → chỉ chào route Gateway"
        fi
      fi
      ;;
    *) dim "BASE ở xa → không chào oMLX trực tiếp (nó chỉ nghe loopback và không có auth)" ;;
  esac

  # AVAILABILITY, not file presence. The distributed .command is BUILT by concatenating the
  # generator ahead of this script (scripts/build-remote-command.sh), so on that copy the
  # functions already exist and there is no sibling to source. Testing for the file would send
  # the single-file build down the stripped fallback — which is exactly what happened on
  # Nguyens-MacBook-Pro: "không thấy lib/dsh-config.sh", gateway route only, on a machine where
  # OpenRouter and Gemini would have worked fine since they are cloud APIs and care nothing
  # about being next to oMLX.
  if command -v dsh_emit_config >/dev/null 2>&1 || { [ -r "$lib" ] && . "$lib"; }; then
    # ONE lookup shape for all four. They used to be three different shapes — a store read, a
    # bare `cat` of ~/.openApiKey, and a scrape of opencode's config — and the odd one out was
    # the one that read a placeholder and reported the route dead (2026-08-18). `dsh_key` knows
    # the store, the legacy paths, and what a placeholder looks like; nothing here needs to.
    OCI_API_KEY="$(dsh_key OCI_API_KEY)"; export OCI_API_KEY
    OPENROUTER_API_KEY="$(dsh_key OPENROUTER_API_KEY)"; export OPENROUTER_API_KEY
    MWAPI_API_KEY="$(dsh_key MWAPI_API_KEY)"; export MWAPI_API_KEY
    GEMINI_API_KEY="$(dsh_key GEMINI_API_KEY)"; export GEMINI_API_KEY
    export AI_GATEWAY_KEY="$KEY"
    local dsh_gateway_model="$MODEL"
    [ "$MODEL" = "local" ] && [ -n "${LIVE_MODEL:-}" ] && dsh_gateway_model="$LIVE_MODEL"
    dsh_emit_config "$BASE" "$dsh_gateway_model" "$omlx_arg" "$def_provider" "$def_model" "$CTX_WINDOW" > "$home/cordis.patch.yml"
    # Read back what was written, never re-derive it: the OCI route is gated on a live 200, so
    # "the key exists" is not the same claim as "the route is there" — and announcing the second
    # from the first is exactly what this printed wrongly before.
    dsh_print_routes "$home/cordis.patch.yml"
    # Report the code the probe actually saw. The old text asserted "401" unconditionally, and
    # was wrong twice over: the endpoint answers 404 to an unknown model and 500 to a max_tokens
    # under 8, and a hard-coded number in a diagnostic is a claim nobody re-measures.
    if [ -n "$OCI_API_KEY" ] && grep -q "oci-osaka:" "$home/cordis.patch.yml" \
       && [ "${DSH_OCI_LAST_CODE:-}" = "000" ]; then
      warn "OCI Osaka có key nhưng probe HTTP 000 — vẫn chào gpt-oss; kết nối chưa xác minh được từ máy này"
    elif [ -n "$OCI_API_KEY" ] && ! grep -q "oci-osaka:" "$home/cordis.patch.yml"; then
      warn "OCI Osaka có key nhưng probe trả HTTP ${DSH_OCI_LAST_CODE:-?} — KHÔNG chào route đó"
    fi
    dsh_print_quota
  else
    warn "không có bộ sinh cấu hình — chỉ dựng route Gateway (bản rút gọn)"
    warn "  bản đầy đủ: dùng scripts/remote-client.command (đã gộp sẵn), hoặc copy cả scripts/lib/"
    # Numbers here are MEASURED on the gateway box, not DSH defaults: DSH assumes a 1,000,000
    # window and a 256,000 output cap, and a client that believes that never compacts, walks
    # past the gateway's context guard and gets a 400 with numbers instead of an answer.
    cat > "$home/cordis.patch.yml" <<YML
- id: llm-deepseek
  config:
    models: []
- id: llm-pi-ai
  name: '@deepseek-ai/dsh-llm-pi-ai'
  config:
    providers:
      ai-gateway:
        displayName: AI Gateway
        apiKeyEnv: AI_GATEWAY_KEY
        api: openai-completions
        baseURL: $BASE/v1
        models:
- id: compaction
  name: cordis:group
  group: true
  isolate:
    compaction: true
    toolResultPruner: true
  config:
    - id: compaction-basic
      name: '@deepseek-ai/dsh-compaction-basic'
      config:
        summarizationProvider: ai-gateway
        summarizationModel: ${MODEL}-nothink
        thresholdRatio: 0.70
        retainRatio: 0.12
        maxTokens: 4096
        compactionRetries: 1
        maxOverflowRetries: 2
    - id: command-compact
      name: '@deepseek-ai/dsh-command-compact'
    - id: tool-result-pruner
      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'
      config:
        thresholdChars: 8192
        headChars: 4096
        tailChars: 1024
- id: agent-default-model
  config:
    provider: ai-gateway
    model: ${MODEL}-think
YML
  fi
  echo; ok "Mở DeepSeek Harness (mặc định → $BASE/v1, model local-think, thinking ON)"
  echo "  đổi đường      → chọn trong picker Model ngay trong giao diện"
  echo "  không tham số  → Web UI ở http://127.0.0.1:3080 (làm việc trong thư mục trên)"
  echo "  một việc cụ thể → $0 dsh --profile headless \"sửa lỗi trong src/main.rs\""
  # No args → the web profile, which is dsh's own primary entry point.
  [ "$#" -eq 0 ] && set -- web
  # oMLX has no api_key configured, so any non-empty value passes; the adapter refuses to
  # start without SOME credential and fails with MISSING_CREDENTIAL naming its entry point.
  # Harmless when the direct route was not written — an unused env var.
  DSH_HOME="$home" AI_GATEWAY_KEY="$KEY" OMLX_API_KEY="${OMLX_API_KEY:-local-no-auth}" \
    npx -y @deepseek-ai/dsh "$@"
  local rc=$?
  dsh_stop_single_model_proxy
  return "$rc"
}

run_chat() {
  need python3 || { err "Chat cần python3 (apt/dnf install python3 trên Linux)."; exit 1; }
  echo; ok "Chat REPL (→ $BASE/v1/chat/completions)"
  # Write the client to a file so python reads the PROGRAM from disk and leaves
  # the terminal on stdin. (`python3 - <<HEREDOC` would consume stdin with the
  # heredoc, so input() would hit EOF and the REPL would exit immediately.)
  local dir="$HOME/.cache/claude-local-remote"; mkdir -p "$dir"
  cat > "$dir/chat.py" <<'PY'
import os, sys, json, urllib.request
base, key, model = os.environ["REMOTE_BASE"], os.environ["REMOTE_KEY"], os.environ["REMOTE_MODEL"]
url = base + "/v1/chat/completions"
msgs = []
print("Chat với AI local (%s). Gõ nội dung, Ctrl-C để thoát.\n" % model)
while True:
    try:
        u = input("\033[1myou ›\033[0m ").strip()
    except (EOFError, KeyboardInterrupt):
        print(); break
    if not u:
        continue
    msgs.append({"role": "user", "content": u})
    # Model reasoning (Ornith) "nghĩ" trước khi trả lời: shim phát comment
    # ": thinking N" (số chữ đã nghĩ) — hiện tiến độ thật thay vì đếm mù.
    # max_tokens 6000: budget phải nuôi được cả phần nghĩ lẫn câu trả lời.
    body = json.dumps({"model": model, "messages": msgs,
                       "stream": True, "max_tokens": 6000}).encode()
    # UA tường minh: Cloudflare Bot Fight chặn UA mặc định "Python-urllib"
    # (error 1010) — thiếu dòng này là 403 từ mọi máy remote
    req = urllib.request.Request(url, body, {
        "Content-Type": "application/json", "Authorization": "Bearer " + key,
        "User-Agent": "ai-remote-chat/1.0"})
    acc = ""; started = False; ticks = 0
    try:
        with urllib.request.urlopen(req) as r:
            for raw in r:
                line = raw.decode("utf-8", "ignore").strip()
                if line.startswith(": thinking") and not started:
                    try:
                        n = int(line.rsplit(None, 1)[-1])
                        sys.stdout.write("\r\033[2m(đang suy nghĩ… ~%d chữ)\033[0m" % n)
                        sys.stdout.flush()
                    except ValueError:
                        pass
                    continue
                if not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    delta = json.loads(data)["choices"][0]["delta"]
                except Exception:
                    continue
                chunk = delta.get("content", "")
                if chunk:
                    if not started:
                        sys.stdout.write("\r\033[K\033[32mai  ›\033[0m ")
                        started = True
                        chunk = chunk.lstrip("\n")
                    acc += chunk
                    sys.stdout.write(chunk); sys.stdout.flush()
                elif not started:
                    ticks += 1
                    if ticks % 5 == 0:
                        sys.stdout.write("\r\033[2m(đang xử lý…)\033[0m")
                        sys.stdout.flush()
    except KeyboardInterrupt:
        sys.stdout.write("\r\033[K"); print("[hủy]"); msgs.pop(); continue
    except Exception as e:
        sys.stdout.write("\r\033[K"); print("[lỗi] %s" % e); msgs.pop(); continue
    if not started:
        sys.stdout.write("\r\033[K\033[32mai  ›\033[0m (không có nội dung — thử lại)\n")
        msgs.pop(); continue
    print("\n")
    msgs.append({"role": "assistant", "content": acc})
PY
  REMOTE_BASE="$BASE" REMOTE_KEY="$KEY" REMOTE_MODEL="$MODEL" exec python3 "$dir/chat.py"
}

cmd="${1:-menu}"
[ "$#" -gt 0 ] && shift

# WHICH DIRECTORY THE AGENT WORKS IN — handled ONCE here, not per launcher.
# Every agent CLI below (claude, codex, opencode, dsh) takes its project root from the process
# working directory, and none of them prints it. That default is not wrong, it is INVISIBLE, and
# an operator who cannot see it looks in the wrong folder. Putting the flag in five launchers
# would be five copies of one rule -- the defect this repo keeps paying for -- so it lives here.
if [ "${1:-}" = "-C" ] || [ "${1:-}" = "--dir" ]; then
  [ -d "${2:-}" ] || { err "Không có thư mục: ${2:-}"; exit 2; }
  cd "$2" || exit 2
  shift 2
fi
case "$cmd" in
  claude|codex|opencode|dsh|workflow) ok "thư mục làm việc: $(pwd -P)" ;;
esac

case "$cmd" in
  claude) run_claude "$@" ;;
  codex)  run_codex  "$@" ;;
  opencode) run_opencode "$@" ;;
  dsh)    run_dsh    "$@" ;;
  chat)   run_chat   "$@" ;;
  workflow) run_workflow "$@" ;;
  status) run_status ;;
  menu)
    echo; bold "Chọn chế độ:"
    echo "  1) Claude Code"
    echo "  2) Codex"
    echo "  3) OpenCode (--auto)"
    echo "  4) DeepSeek Harness (Web UI / headless)"
    echo "  5) Chat"
    echo "  6) Workflow (chạy plan nhiều task tự động — mỗi task chấm bằng test đóng băng, resume được)"
    echo "  7) Kiểm tra AI sống không (status)"
    printf "› "; read -r choice
    case "$choice" in
      1) run_claude ;;
      2) run_codex ;;
      3) run_opencode ;;
      4) run_dsh ;;
      5) run_chat ;;
      6) run_workflow ;;
      7) run_status ;;
      *) err "Lựa chọn không hợp lệ."; exit 1 ;;
    esac ;;
  *) err "Lệnh không rõ: $cmd  (dùng: claude | codex | opencode | dsh | chat | workflow | status)"; exit 1 ;;
esac
